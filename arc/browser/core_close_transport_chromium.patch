 void BrowserWebContentsDelegate::CloseContents(content::WebContents* source) {
+  if (source &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app")) {
+    const auto hook = arcmod::GetNativeCloseContentsHook();
+    if (hook) {
+      auto continuation = base::BindOnce(
+          &BrowserWebContentsDelegate::ContinueHostCloseContents,
+          weak_factory_.GetWeakPtr(), source->GetWeakPtr());
+      hook.Run(source, std::move(continuation));
+      // The hook or continuation can synchronously delete this delegate.
+      return;
+    }
+  }
+  CloseContentsWithoutHostHook(source);
+}
+
+void BrowserWebContentsDelegate::ContinueHostCloseContents(
+    base::WeakPtr<content::WebContents> source) {
+  if (source) {
+    CloseContentsWithoutHostHook(source.get());
+  }
+}
+
+void BrowserWebContentsDelegate::CloseContentsWithoutHostHook(
+    content::WebContents* source) {
   if (unload_controller_->CanCloseContents(source)) {
     chrome::CloseWebContents(&browser_.get(), source, true);
   }
