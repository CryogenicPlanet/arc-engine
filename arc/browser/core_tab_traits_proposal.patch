+// Copyright 2026 ArcMod. Receipt-time tab alert and cached WebRTC traits.
+#ifndef ARC_BROWSER_CORE_TAB_TRAITS_H_
+#define ARC_BROWSER_CORE_TAB_TRAITS_H_
+
+#import <Foundation/Foundation.h>
+
+#include <cstdint>
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/peer_connection_tracker_host_observer.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace arc {
+
+using CoreTabTraitsSnapshot = std::vector<uint32_t>;
+
+// Construct ONLY in the existing delivery task, BEFORE loading its weak ObjC
+// owner, matching bridge 4413050. Every call returns a fresh mutable set, even
+// for empty snapshots or an owner that has expired. Values >13 are ignored.
+NSMutableIndexSet* MaterializeCoreTabTraits(
+    const CoreTabTraitsSnapshot& snapshot);
+
+// UI-thread only. Construction registers the public peer observer but performs
+// no replay, tab/controller creation, publication, or task posting. The caller
+// owns this object alongside the logical contents and must provide the exact
+// native will-discard handoff before using it across contents replacement.
+class CoreTabTraitsState final
+    : public content::PeerConnectionTrackerHostObserver {
+ public:
+  explicit CoreTabTraitsState(content::WebContents* contents);
+  ~CoreTabTraitsState() override;
+  CoreTabTraitsState(const CoreTabTraitsState&) = delete;
+  CoreTabTraitsState& operator=(const CoreTabTraitsState&) = delete;
+
+  // Copy CURRENT CACHED alerts at native flag receipt, without constructing an
+  // ObjC object. Preserve order and duplicate mapped values (including zero).
+  // Missing native/tab/controller returns empty, including omission of13.
+  CoreTabTraitsSnapshot SnapshotCachedTraits() const;
+
+  // Only the native will-discard/replacement handoff resets the peer cache.
+  // Ordinary navigation must not call this method.
+  void RebindForDiscard(content::WebContents* new_contents);
+
+ private:
+  using PeerKey = std::pair<content::GlobalRenderFrameHostId, int>;
+
+  bool OwnsFrame(content::GlobalRenderFrameHostId frame_id) const;
+  void RecomputeICEAlert();
+  void OnPeerConnectionAdded(content::GlobalRenderFrameHostId frame_id,
+                             int lid,
+                             base::ProcessId pid,
+                             const std::string& url,
+                             const std::string& rtc_configuration) override;
+  void OnPeerConnectionRemoved(content::GlobalRenderFrameHostId frame_id,
+                               int lid) override;
+  void OnPeerConnectionUpdated(content::GlobalRenderFrameHostId frame_id,
+                               int lid,
+                               const std::string& type,
+                               const std::string& value) override;
+
+  base::WeakPtr<content::WebContents> contents_;
+  std::map<PeerKey, bool> peers_;
+  // Intentionally separate from peers_: Added resets a bit without refreshing
+  // this value, and Snapshot must preserve that original cache timing.
+  bool ice_alert_active_ = false;
+};
+
+}  // namespace arc
+
+#endif  // ARC_BROWSER_CORE_TAB_TRAITS_H_
