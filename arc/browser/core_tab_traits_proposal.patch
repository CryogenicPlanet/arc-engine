@@ -0,0 +1,171 @@
+// Copyright 2026 ArcMod. Receipt-time tab alert and cached WebRTC traits.
+#import "arc/browser/core_tab_traits.h"
+
+#include <algorithm>
+
+#include "chrome/browser/ui/tabs/alert/tab_alert_controller.h"
+#include "components/tabs/public/tab_alert.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace arc {
+namespace {
+
+uint32_t ArcTraitForAlert(tabs::TabAlert alert) {
+  switch (alert) {
+    case tabs::TabAlert::kMediaRecording:
+      return 1;
+    case tabs::TabAlert::kTabCapturing:
+      return 2;
+    case tabs::TabAlert::kAudioPlaying:
+      return 3;
+    case tabs::TabAlert::kAudioMuting:
+      return 4;
+    case tabs::TabAlert::kBluetoothConnected:
+      return 5;
+    case tabs::TabAlert::kBluetoothScanActive:
+      return 6;
+    case tabs::TabAlert::kUsbConnected:
+      return 7;
+    case tabs::TabAlert::kHidConnected:
+      return 8;
+    case tabs::TabAlert::kSerialConnected:
+      return 9;
+    case tabs::TabAlert::kPipPlaying:
+      return 10;
+    case tabs::TabAlert::kDesktopCapturing:
+      return 11;
+    case tabs::TabAlert::kVrPresentingInHeadset:
+      return 12;
+    case tabs::TabAlert::kNone:
+    case tabs::TabAlert::kAudioRecording:
+    case tabs::TabAlert::kVideoRecording:
+    case tabs::TabAlert::kGlicAccessing:
+    case tabs::TabAlert::kGlicSharing:
+    case tabs::TabAlert::kActorAccessing:
+    case tabs::TabAlert::kActorWaitingOnUser:
+      return 0;
+    default:
+      return 0;
+  }
+}
+
+}  // namespace
+
+NSMutableIndexSet* MaterializeCoreTabTraits(
+    const CoreTabTraitsSnapshot& snapshot) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  NSMutableIndexSet* traits = [[NSMutableIndexSet alloc] init];
+  for (uint32_t trait : snapshot) {
+    if (trait <= 13) {
+      [traits addIndex:trait];
+    }
+  }
+  return traits;
+}
+
+CoreTabTraitsState::CoreTabTraitsState(content::WebContents* contents)
+    : contents_(contents ? contents->GetWeakPtr()
+                         : base::WeakPtr<content::WebContents>()) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+}
+
+CoreTabTraitsState::~CoreTabTraitsState() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+}
+
+CoreTabTraitsSnapshot CoreTabTraitsState::SnapshotCachedTraits() const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CoreTabTraitsSnapshot traits;
+  if (!contents_) {
+    return traits;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(contents_.get());
+  if (!tab) {
+    return traits;
+  }
+  auto* controller = tabs::TabAlertController::From(tab);
+  if (!controller) {
+    return traits;
+  }
+  for (tabs::TabAlert alert : controller->GetAllActiveAlerts()) {
+    traits.push_back(ArcTraitForAlert(alert));
+  }
+  if (ice_alert_active_) {
+    traits.push_back(13);
+  }
+  return traits;
+}
+
+void CoreTabTraitsState::RebindForDiscard(content::WebContents* new_contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  contents_ = new_contents ? new_contents->GetWeakPtr()
+                           : base::WeakPtr<content::WebContents>();
+  peers_.clear();
+  ice_alert_active_ = false;
+}
+
+bool CoreTabTraitsState::OwnsFrame(
+    content::GlobalRenderFrameHostId frame_id) const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!contents_) {
+    return false;
+  }
+  auto* frame = content::RenderFrameHost::FromID(frame_id);
+  return frame &&
+         content::WebContents::FromRenderFrameHost(frame) == contents_.get();
+}
+
+void CoreTabTraitsState::RecomputeICEAlert() {
+  ice_alert_active_ = std::any_of(
+      peers_.begin(), peers_.end(), [](const auto& peer) { return peer.second; });
+}
+
+void CoreTabTraitsState::OnPeerConnectionAdded(
+    content::GlobalRenderFrameHostId frame_id,
+    int lid,
+    base::ProcessId,
+    const std::string&,
+    const std::string&) {
+  if (!OwnsFrame(frame_id)) {
+    return;
+  }
+  peers_.insert_or_assign(PeerKey(frame_id, lid), false);
+  // Original Added does not recompute the cached aggregate, even for duplicates.
+}
+
+void CoreTabTraitsState::OnPeerConnectionRemoved(
+    content::GlobalRenderFrameHostId frame_id,
+    int lid) {
+  if (!OwnsFrame(frame_id)) {
+    return;
+  }
+  peers_.erase(PeerKey(frame_id, lid));
+  RecomputeICEAlert();
+}
+
+void CoreTabTraitsState::OnPeerConnectionUpdated(
+    content::GlobalRenderFrameHostId frame_id,
+    int lid,
+    const std::string& type,
+    const std::string& value) {
+  if (!OwnsFrame(frame_id) || type != "oniceconnectionstatechange") {
+    return;
+  }
+  auto peer = peers_.find(PeerKey(frame_id, lid));
+  if (peer == peers_.end()) {
+    return;
+  }
+  if (value == "\"connected\"" || value == "\"checking\"" ||
+      value == "\"completed\"") {
+    peer->second = true;
+  } else if (value == "\"failed\"" || value == "\"disconnected\"" ||
+             value == "\"closed\"" || value == "\"new\"") {
+    peer->second = false;
+  }
+  RecomputeICEAlert();
+}
+
+}  // namespace arc
