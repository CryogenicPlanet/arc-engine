{
  "key": "",
  "name": "Arc Internal Extension",
  "version": "0.0.10",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "split",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://app.slack.com/*",
    "https://chromewebstore.google.com/*",
    "https://www.notion.so/*"
  ]
}
