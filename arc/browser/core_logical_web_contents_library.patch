@@ -0,0 +1,99 @@
+// Copyright 2026 ArcMod. Bare logical library; no consumer is installed.
+#include "arc/browser/core_logical_web_contents.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/web_contents.h"
+
+namespace arc {
+
+// This deleter never owns another shared logical handle. std::shared_ptr ends
+// strong ownership before invoking it, including when UI deletion is deferred.
+struct CoreLogicalWebContentsDeleter {
+  void operator()(CoreLogicalWebContents* logical) const {
+    if (content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+      delete logical;
+      return;
+    }
+    // As with BrowserThread::DeleteOnUIThread, rejection at shutdown leaks the
+    // raw object rather than destroying UI-owned state on the releasing thread.
+    content::GetUIThreadTaskRunner({})->DeleteSoon(FROM_HERE, logical);
+  }
+};
+
+CoreMediaPeer::~CoreMediaPeer() = default;
+CoreDevToolsPeer::~CoreDevToolsPeer() = default;
+
+CoreLogicalWebContentsHandle CreateCoreLogicalWebContents(
+    base::WeakPtr<content::WebContents> contents,
+    CoreCloseStateHandle close_state,
+    CoreMediaPeerFactory media_factory,
+    CoreDevToolsPeerFactory devtools_factory) {
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  CHECK(contents);
+  CHECK(close_state);
+  CHECK(media_factory);
+  CHECK(devtools_factory);
+
+  CoreLogicalWebContentsHandle logical(
+      new CoreLogicalWebContents(std::move(contents), std::move(close_state)),
+      CoreLogicalWebContentsDeleter());
+  CoreLogicalWebContentsWeakHandle weak_logical(logical);
+  logical->media_peer_ = std::move(media_factory).Run(weak_logical);
+  CHECK(logical->media_peer_);
+  logical->devtools_peer_ = std::move(devtools_factory).Run(weak_logical);
+  CHECK(logical->devtools_peer_);
+  return logical;
+}
+
+CoreLogicalWebContents::CoreLogicalWebContents(
+    base::WeakPtr<content::WebContents> contents,
+    CoreCloseStateHandle close_state)
+    : contents_(std::move(contents)), close_state_(std::move(close_state)) {
+  CheckUISequence();
+}
+
+CoreLogicalWebContents::~CoreLogicalWebContents() {
+  CheckUISequence();
+}
+
+void CoreLogicalWebContents::CheckUISequence() const {
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+base::WeakPtr<content::WebContents>
+CoreLogicalWebContents::GetNativeWeakPtr() const {
+  CheckUISequence();
+  return contents_;
+}
+
+content::WebContents* CoreLogicalWebContents::GetNative() const {
+  CheckUISequence();
+  return contents_.get();
+}
+
+CoreCloseStateHandle CoreLogicalWebContents::GetCloseState() const {
+  CheckUISequence();
+  return close_state_;
+}
+
+std::shared_ptr<CoreMediaPeer> CoreLogicalWebContents::GetMediaPeer() const {
+  CheckUISequence();
+  CHECK(media_peer_);
+  return media_peer_;
+}
+
+std::shared_ptr<CoreDevToolsPeer> CoreLogicalWebContents::GetDevToolsPeer() const {
+  CheckUISequence();
+  CHECK(devtools_peer_);
+  return devtools_peer_;
+}
+
+}  // namespace arc
