+void DevToolsUIBindings::InspectModeChanged(const std::string& mode) {
+  if (auto hook = arcmod::GetDevToolsInspectModeHook(); !hook.is_null()) {
+    hook.Run(delegate_->GetInspectedWebContents(), web_contents_, mode);
+  }
+  // The hook may destroy these bindings. Do not access members after it runs.
+}
+
+void DevToolsUIBindings::RequestDockPosition(const std::string& side) {
+  if (auto hook = arcmod::GetDevToolsDockPositionHook(); !hook.is_null()) {
+    hook.Run(delegate_->GetInspectedWebContents(), web_contents_, side);
+  }
+  // Association is already established by the construction hook; no Show needed.
+}
