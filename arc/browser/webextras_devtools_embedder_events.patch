+    content::WebContents* inspected, content::WebContents* frontend)>;
+inline DevToolsFrontendCreatedHook& GetDevToolsFrontendCreatedHook() {
+  static base::NoDestructor<DevToolsFrontendCreatedHook> hook;
+  return *hook;
+}
+
+// Exact one-string frontend embedder notifications, independent of CDP traffic.
+using DevToolsFrontendStringHook = base::RepeatingCallback<void(
+    content::WebContents* inspected, content::WebContents* frontend,
+    const std::string& value)>;
+inline DevToolsFrontendStringHook& GetDevToolsInspectModeHook() {
+  static base::NoDestructor<DevToolsFrontendStringHook> hook;
+  return *hook;
+}
+inline DevToolsFrontendStringHook& GetDevToolsDockPositionHook() {
+  static base::NoDestructor<DevToolsFrontendStringHook> hook;
+  return *hook;
+}
