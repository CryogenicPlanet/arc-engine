+class MediaVolumeOuterWebContentsTest : public MediaWebContentsObserverTest {
+ public:
+  MediaVolumeOuterWebContentsTest() {
+    feature_list_.InitAndDisableFeature(features::kGuestViewMPArch);
+  }
+
+ private:
+  base::test::ScopedFeatureList feature_list_;
+};
+
+TEST_F(MediaVolumeOuterWebContentsTest, VolumeNotifiesOnlyOutermostContents) {
+  auto middle = TestWebContents::Create(browser_context(), nullptr);
+  auto* middle_contents = middle.get();
+  auto inner = TestWebContents::Create(browser_context(), nullptr);
+  auto* inner_contents = inner.get();
+  VolumeObserver root_observer(contents());
+  VolumeObserver middle_observer(middle_contents);
+  VolumeObserver inner_observer(inner_contents);
+
+  auto append_container = [](WebContents* outer, const char* name) {
+    auto* main = outer->GetPrimaryMainFrame();
+    RenderFrameHostTester::For(main)->InitializeRenderFrameIfNeeded();
+    auto* child = RenderFrameHostTester::For(main)->AppendChild(name);
+    RenderFrameHostTester::For(child)->InitializeRenderFrameIfNeeded();
+    return child;
+  };
+  auto* inner_container = append_container(middle_contents, "inner");
+  middle_contents->AttachInnerWebContents(std::move(inner), inner_container,
+                                         /*is_full_page=*/false);
+  EXPECT_EQ(inner_contents->GetOuterWebContents(), middle_contents);
+  inner_contents->MediaVolumeChanged(0.625);
+  EXPECT_EQ(middle_observer.volumes, (std::vector<double>{0.625}));
+  EXPECT_TRUE(root_observer.volumes.empty());
+  EXPECT_TRUE(inner_observer.volumes.empty());
+
+  auto* middle_container = append_container(contents(), "middle");
+  contents()->AttachInnerWebContents(std::move(middle), middle_container,
+                                    /*is_full_page=*/false);
+  EXPECT_EQ(inner_contents->GetOutermostWebContents(), contents());
+  middle_observer.volumes.clear();
+  inner_contents->MediaVolumeChanged(0.375);
+  middle_contents->MediaVolumeChanged(0.375);
+  inner_contents->MediaVolumeChanged(0.123456789123);
+  contents()->MediaVolumeChanged(0.0);
+  EXPECT_EQ(root_observer.volumes,
+            (std::vector<double>{0.375, 0.375, 0.123456789123, 0.0}));
+  EXPECT_TRUE(middle_observer.volumes.empty());
+  EXPECT_TRUE(inner_observer.volumes.empty());
+}
