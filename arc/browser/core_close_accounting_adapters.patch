+// Copyright 2026 ArcMod. Typed adapters for exact logical WebContents accounting.
+#ifndef ARC_BROWSER_CORE_CLOSE_ADAPTERS_H_
+#define ARC_BROWSER_CORE_CLOSE_ADAPTERS_H_
+
+#include "arc/browser/core_close_state.h"
+
+#ifdef __OBJC__
+@class ArcWebContents;
+namespace arc {
+// Live canonical wrappers have a state before their first initializer setter.
+// Requires nonnil owner; never creates a wrapper or substitutes a fresh state.
+CoreCloseStateHandle CoreCloseStateForWebContents(ArcWebContents* owner);
+
+// Each call represents one native NotifyObserversImpl, with a distinct trailer.
+void PostCoreWebContentsNotification(CoreCloseStateHandle state,
+                                     void (^delivery)());
+// Acquire pending at this producer, retaining only state through delivery return.
+void PostCoreUIDelegateInvocation(CoreCloseStateHandle state,
+                                  void (^conditional_delivery)());
+}  // namespace arc
+#endif
+#endif  // ARC_BROWSER_CORE_CLOSE_ADAPTERS_H_
