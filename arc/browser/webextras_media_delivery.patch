+    // early retirement hook to preserve its public binding through app return;
+    // this Source WeakPtr alone cannot preserve that binding. No accepted task
+    // checks physical attachment or service liveness.
+    if (observer_) { observer_->Detach(); }
+    PiPDestroyed();
+    contents_.reset();
+  }
+  void Info(media_session::mojom::MediaSessionInfoPtr info) {
+    if (!info) { return; }
+    const auto state = static_cast<uint64_t>(info->state);
+    if (WebextrasMediaInfoCache::Update(cache_.state, state)) {
+      delivery.Async(shared_from_this(), state, [](id<ArcMediaDelegate> d, ArcWebContents* o, uint64_t v) {
+        if ([d respondsToSelector:@selector(webContents:didChangeMediaSessionState:)]) { [d webContents:o didChangeMediaSessionState:v]; }
+      });
+    }
+    const auto camera = static_cast<uint64_t>(info->camera_state);
+    if (WebextrasMediaInfoCache::Update(cache_.camera, camera)) {
+      delivery.Async(shared_from_this(), camera, [](id<ArcMediaDelegate> d, ArcWebContents* o, uint64_t v) {
+        if ([d respondsToSelector:@selector(webContents:didChangeCameraState:)]) { [d webContents:o didChangeCameraState:v]; }
+      });
+    }
+    const auto microphone = static_cast<uint64_t>(info->microphone_state);
+    if (WebextrasMediaInfoCache::Update(cache_.microphone, microphone)) {
+      delivery.Async(shared_from_this(), microphone, [](id<ArcMediaDelegate> d, ArcWebContents* o, uint64_t v) {
+        if ([d respondsToSelector:@selector(webContents:didChangeMicrophoneState:)]) { [d webContents:o didChangeMicrophoneState:v]; }
+      });
+    }
+  }
+  void Actions(const std::vector<media_session::mojom::MediaSessionAction>& actions) {
+    std::vector<NSUInteger> copied;
+    for (auto action : actions) {
+      const auto index = static_cast<NSUInteger>(action);
+      if (index < 21) { copied.push_back(index); }
+    }
+    delivery.AsyncPrepared(shared_from_this(), std::move(copied),
+        [](const std::vector<NSUInteger>& values) {
+          NSMutableIndexSet* indices = [NSMutableIndexSet indexSet];
+          for (auto value : values) { [indices addIndex:value]; }
+          return indices;
+        }, [](id<ArcMediaDelegate> d, ArcWebContents* o, NSIndexSet* indices) {
