+// The logical owner retains functional source state without eagerly creating
+// the public ObjC service. Source/queued payloads do not retain this box/owner.
+@interface WebextrasMediaSourceBox : NSObject {
+ @public
+  std::shared_ptr<WebextrasMediaSource> source;
