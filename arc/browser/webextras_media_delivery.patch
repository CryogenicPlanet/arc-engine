+        [](const media_session::MediaPosition& value) {
+          return [[ArcMediaPosition alloc] initWithMediaPosition:&value];
+        }, [](id<ArcMediaDelegate> d, ArcWebContents* o, ArcMediaPosition* wrapper) {
+          if ([d respondsToSelector:@selector(webContents:didChangeMediaPosition:)]) { [d webContents:o didChangeMediaPosition:wrapper]; }
+        });
+  }
+  // The original volume producer is async too. No current Chromium producer
+  // calls this entry: the renderer double-valued IPC is a separate dependency.
+  void VolumeChanged(double volume) {
+    delivery.Async(shared_from_this(), volume, [](id<ArcMediaDelegate> d, ArcWebContents* o, double value) {
+      if ([d respondsToSelector:@selector(webContents:didChangeVolume:)]) { [d webContents:o didChangeVolume:value]; }
+    });
+  }
+  std::optional<media_session::MediaPosition> PositionSnapshot() const { return position_; }
+  void PiPCreated();
+  void PiPDestroyed();
+  WebextrasMediaDelivery delivery;
+  __weak ArcWebContentsMediaSession* service = nil;  // Cache maintenance only.
+ private:
+  __weak ArcWebContents* owner_;
+  base::WeakPtr<content::WebContents> contents_;
+  std::unique_ptr<ArcMediaObserver> observer_;
+  WebextrasMediaInfoCache cache_;
+  std::optional<media_session::MediaPosition> position_;
+  bool pip_destroyed_ = false;
 };
