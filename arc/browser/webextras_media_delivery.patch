+// Only the ObjC service owns its current bridge. Registration and accepted tasks
+// refer weakly to the bridge selected at receipt, rather than to the service.
+class WebextrasMediaDelivery {
+ public:
+  void Register(const std::shared_ptr<WebextrasMediaDelegateBridge>& bridge) {
+    registered_ = bridge;
+  }
+
+  template <typename Callback>
+  void Sync(Callback callback) const {
+    Deliver(registered_, std::move(callback));
+  }
+
+  template <typename Prepare, typename Callback>
+  void SyncPrepared(Prepare prepare, Callback callback) const {
+    DeliverPrepared(registered_, std::move(prepare), std::move(callback));
+  }
+
+  template <typename Source, typename Payload, typename Callback>
+  void Async(std::shared_ptr<Source> source, Payload payload,
+             Callback callback) const {
+    AsyncPrepared(std::move(source), std::move(payload),
+                  [](const Payload& value) { return value; }, std::move(callback));
+  }
+
+  template <typename Source, typename Payload, typename Prepare, typename Callback>
+  void AsyncPrepared(std::shared_ptr<Source> source, Payload payload,
+                     Prepare prepare, Callback callback) const {
+    auto selected = registered_;
+    // Native expired registrations enqueue inert work, without acquiring a
+    // counted invocation. Accounting is deliberately a separate proposal.
+    if (selected.expired()) {
+      PostWebextrasMediaTask(base::BindOnce(
+          [](std::shared_ptr<Source> source) { (void)source; }, std::move(source)));
+      return;
+    }
+    PostWebextrasMediaTask(base::BindOnce(
+        [](std::shared_ptr<Source> source,
+           std::weak_ptr<WebextrasMediaDelegateBridge> selected, Payload payload,
+           Prepare prepare, Callback callback) {
+          // This is functional source ownership: observer, caches, dispatch and
+          // PiP latch survive independently of the ObjC service/physical WC.
+          (void)source;
+          DeliverPrepared(selected, [&] { return prepare(payload); },
+                          std::move(callback));
+        }, std::move(source), selected, std::move(payload), std::move(prepare),
+        std::move(callback)));
+  }
+
+ private:
+  template <typename Callback>
+  static void Deliver(std::weak_ptr<WebextrasMediaDelegateBridge> selected,
+                      Callback callback) {
+    DeliverPrepared(selected, [] { return 0; },
+                    [&](id<ArcMediaDelegate> d, ArcWebContents* o, int) {
+                      callback(d, o);
+                    });
+  }
+  template <typename Prepare, typename Callback>
+  static void DeliverPrepared(std::weak_ptr<WebextrasMediaDelegateBridge> selected,
+                              Prepare prepare, Callback callback) {
+    auto bridge = selected.lock();
+    if (!bridge) { return; }
+    auto prepared = prepare();  // DTO allocation precedes weak ObjC loads.
+    // Keep the selected registration alive THROUGH app return. A nested run
+    // loop may drain more work for this same bridge after nil/re-add.
+    // C++ automatic storage has scope lifetime; the ObjC loads need explicit
+    // precise lifetime because ARC may otherwise release at their last use.
+    id<ArcMediaDelegate> __attribute__((objc_precise_lifetime)) delegate = bridge->delegate;
+    ArcWebContents* __attribute__((objc_precise_lifetime)) owner = bridge->owner;
+    callback(delegate, owner, prepared);  // nil owner is allowed.
+  }
+  std::weak_ptr<WebextrasMediaDelegateBridge> registered_;
+};
