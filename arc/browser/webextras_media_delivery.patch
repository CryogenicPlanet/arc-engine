+namespace {
+const char kWebextrasMediaSourceKey = 0;
+std::shared_ptr<WebextrasMediaSource> GetWebextrasMediaSource(ArcWebContents* owner) {
+  WebextrasMediaSourceBox* box = objc_getAssociatedObject(owner, &kWebextrasMediaSourceKey);
+  return box ? box->source : nullptr;
+}
+}
