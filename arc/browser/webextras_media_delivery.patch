+// BEGIN WEBEXTRAS_MEDIA_DELIVERY_HELPER -- compiled by the owned regression test.
+struct WebextrasMediaDelegateBridge {
+  __weak id<ArcMediaDelegate> delegate;
+  __weak ArcWebContents* owner;
