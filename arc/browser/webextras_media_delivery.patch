+namespace arc {
+void InitializeWebextrasMediaSource(ArcWebContents* owner, content::WebContents* native) {
+  if (!owner || !native || GetWebextrasMediaSource(owner)) { return; }
+  WebextrasMediaSourceBox* box = [[WebextrasMediaSourceBox alloc] init];
+  box->source = std::make_shared<WebextrasMediaSource>(owner);
+  objc_setAssociatedObject(owner, &kWebextrasMediaSourceKey, box, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  arcmod::GetVideoOverlayWindowHook() = base::BindRepeating(&arc::CreateVideoOverlayWindow);
+  box->source->AttachInitial(native);
 }
