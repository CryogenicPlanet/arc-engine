+ public:
+  explicit WebextrasMediaSource(ArcWebContents* owner) : owner_(owner) {}
+  void AttachInitial(content::WebContents* contents) {
+    // The core hook publishes this source before subscription. Observer initial
+    // messages remain asynchronous Mojo receipts, never a synthetic flush.
+    contents_ = contents->GetWeakPtr();
