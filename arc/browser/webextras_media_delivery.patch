+struct WebextrasMediaInfoCache {
+  std::optional<uint64_t> state;
+  std::optional<uint64_t> camera;
+  std::optional<uint64_t> microphone;
+  static bool Update(std::optional<uint64_t>& cached, uint64_t value) {
+    const bool changed = !cached || *cached != value;
+    cached = value;
+    return changed;
+  }
+};
