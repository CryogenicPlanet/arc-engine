+// Copyright 2026 ArcMod. No close behavior or native/wrapper lookup is installed.
+#include "arc/browser/core_close_state.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <utility>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "base/task/single_thread_task_runner.h"
+
+namespace arc {
+namespace {
+constexpr size_t kDelegateChannels = 3;
+constexpr size_t kObserverChannels = 2;
+
+size_t Index(CoreCloseDelegateChannel channel) {
+  switch (channel) {
+    case CoreCloseDelegateChannel::kUI: return 0;
+    case CoreCloseDelegateChannel::kNavigation: return 1;
+    case CoreCloseDelegateChannel::kMedia: return 2;
+  }
+  CHECK(false) << "Invalid close delegate channel";
+}
+
+size_t Index(CoreCloseObserverChannel channel) {
+  switch (channel) {
+    case CoreCloseObserverChannel::kWebContents: return 0;
+    case CoreCloseObserverChannel::kNavigationController: return 1;
+  }
+  CHECK(false) << "Invalid close observer channel";
+}
+}  // namespace
+
+class CoreCloseState final {
+ public:
+  bool IsBusy() const {
+    CheckSequence();
+    for (size_t index = 0; index < kDelegateChannels; ++index) {
+      if (synchronous_[index] || pending_[index]) {
+        return true;
+      }
+    }
+    for (uint64_t batches : batches_) {
+      if (batches) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool EnterSync(CoreCloseDelegateChannel channel) {
+    CheckSequence();
+    return std::exchange(synchronous_[Index(channel)], true);
+  }
+
+  void LeaveSync(CoreCloseDelegateChannel channel, bool previous) {
+    CheckSequence();
+    synchronous_[Index(channel)] = previous;
+  }
+
+  void AddPending(CoreCloseDelegateChannel channel) {
+    CheckSequence();
+    uint64_t& pending = pending_[Index(channel)];
+    CHECK_LT(pending, std::numeric_limits<uint64_t>::max());
+    ++pending;
+  }
+
+  void CompletePending(CoreCloseDelegateChannel channel) {
+    CheckSequence();
+    uint64_t& pending = pending_[Index(channel)];
+    CHECK_GT(pending, 0u);
+    --pending;
+  }
+
+  void AddBatch(CoreCloseObserverChannel channel) {
+    CheckSequence();
+    uint64_t& batches = batches_[Index(channel)];
+    CHECK_LT(batches, std::numeric_limits<uint64_t>::max());
+    ++batches;
+  }
+
+  void CompleteBatch(CoreCloseObserverChannel channel) {
+    CheckSequence();
+    uint64_t& batches = batches_[Index(channel)];
+    CHECK_GT(batches, 0u);
+    --batches;
+  }
+
+  void CheckSequence() const {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  }
+
+ private:
+  std::array<bool, kDelegateChannels> synchronous_{};
+  std::array<uint64_t, kDelegateChannels> pending_{};
+  std::array<uint64_t, kObserverChannels> batches_{};
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+CoreCloseStateHandle CreateCoreCloseState() {
+  return std::make_shared<CoreCloseState>();
+}
+
+bool CoreCloseStateIsBusy(const CoreCloseStateHandle& state) {
+  CHECK(state);
+  return state->IsBusy();
+}
+
+ScopedCoreCloseInvocation::ScopedCoreCloseInvocation(
+    CoreCloseStateHandle state,
+    CoreCloseDelegateChannel channel)
+    : state_(std::move(state)), channel_(channel) {
+  CHECK(state_);
+  previous_ = state_->EnterSync(channel_);
+}
+
+ScopedCoreCloseInvocation::~ScopedCoreCloseInvocation() {
+  state_->LeaveSync(channel_, previous_);
+}
+
+base::OnceClosure MakeCoreCloseAsyncInvocation(
+    CoreCloseStateHandle state,
+    CoreCloseDelegateChannel channel,
+    base::OnceClosure conditional_callback) {
+  CHECK(state);
+  state->AddPending(channel);
+  return base::BindOnce(
+      [](CoreCloseStateHandle state, CoreCloseDelegateChannel channel,
+         base::OnceClosure callback) {
+        state->CheckSequence();
+        if (callback) {
+          std::move(callback).Run();
+        }
+        // Retain only the captured accounting state through invocation return.
+        // Skipped/expired target paths are inside callback and also reach here.
+        state->CompletePending(channel);
+      },
+      std::move(state), channel, std::move(conditional_callback));
+}
+
+CoreCloseObserverBatch::CoreCloseObserverBatch(
+    CoreCloseStateHandle state,
+    CoreCloseObserverChannel channel)
+    : state_(std::move(state)), channel_(channel) {
+  CHECK(state_);
+  state_->AddBatch(channel_);
+}
+
+CoreCloseObserverBatch::~CoreCloseObserverBatch() = default;
+
+bool CoreCloseObserverBatch::PostFinalizer(
+    const base::Location& from_here,
+    scoped_refptr<base::SingleThreadTaskRunner> primary_ui_runner) {
+  CHECK(state_);  // Exactly one post attempt for this batch.
+  state_->CheckSequence();
+  CHECK(primary_ui_runner);
+  CHECK(primary_ui_runner->RunsTasksInCurrentSequence());
+  // The caller posted all deliveries first. Even an empty batch posts this task.
+  // Neither rejection nor closure destruction synthesizes a native decrement.
+  return primary_ui_runner->PostTask(
+      from_here,
+      base::BindOnce(
+          [](CoreCloseStateHandle state, CoreCloseObserverChannel channel) {
+            state->CompleteBatch(channel);
+          },
+          std::move(state_), channel_));
+}
+
+}  // namespace arc
