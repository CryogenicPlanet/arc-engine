+// Copyright 2026 ArcMod. Shared accounting for one logical Arc WebContents.
+#ifndef ARC_BROWSER_CORE_CLOSE_STATE_H_
+#define ARC_BROWSER_CORE_CLOSE_STATE_H_
+
+#include <memory>
+
+#include "base/functional/callback_forward.h"
+#include "base/memory/scoped_refptr.h"
+
+namespace base {
+class Location;
+class SingleThreadTaskRunner;
+}  // namespace base
+
+namespace arc {
+
+// The state owns no native contents, Objective-C wrapper, delegate, or runner.
+// Create and access it on the logical contents' primary UI sequence. Queued work
+// captures this exact handle, never a lookup by native pointer at completion.
+class CoreCloseState;
+using CoreCloseStateHandle = std::shared_ptr<CoreCloseState>;
+
+// Delegate invocation accounting and observer batch accounting are distinct.
+enum class CoreCloseDelegateChannel { kUI, kNavigation, kMedia };
+enum class CoreCloseObserverChannel { kWebContents, kNavigationController };
+
+CoreCloseStateHandle CreateCoreCloseState();
+bool CoreCloseStateIsBusy(const CoreCloseStateHandle& state);
+
+// Stack/LIFO scope, including nested calls of the same channel. Restores the
+// previous synchronous flag only after the selector invocation has returned.
+class [[nodiscard]] ScopedCoreCloseInvocation final {
+ public:
+  ScopedCoreCloseInvocation(CoreCloseStateHandle state,
+                            CoreCloseDelegateChannel channel);
+  ~ScopedCoreCloseInvocation();
+  ScopedCoreCloseInvocation(const ScopedCoreCloseInvocation&) = delete;
+  ScopedCoreCloseInvocation& operator=(const ScopedCoreCloseInvocation&) = delete;
+  ScopedCoreCloseInvocation(ScopedCoreCloseInvocation&&) = delete;
+  ScopedCoreCloseInvocation& operator=(ScopedCoreCloseInvocation&&) = delete;
+
+ private:
+  CoreCloseStateHandle state_;
+  CoreCloseDelegateChannel channel_;
+  bool previous_;
+};
+
+// Call immediately at enqueue, then post the returned closure with the caller's
+// unchanged runner, location, delay, and nesting policy. Pending is acquired now
+// and released after conditional_callback RETURNS, including a no-op/expired
+// target path. A null callback also consumes one invocation when the task runs.
+//
+// Destruction without Run() DOES NOT release pending. Audited native producers
+// ignore rejected posts without rollback; a rejected/canceled task leaves this
+// exact state busy while it survives. Do not synthesize decrement or delivery.
+// Other producer forms require their own source proof before adoption.
+base::OnceClosure MakeCoreCloseAsyncInvocation(
+    CoreCloseStateHandle state,
+    CoreCloseDelegateChannel channel,
+    base::OnceClosure conditional_callback);
+
+// Begin before posting a notification's existing per-registration deliveries.
+// This increments once for the entire notification, including an empty list.
+// After ALL delivery posts, call PostFinalizer exactly once with their original
+// primary UI runner. It posts a SEPARATE ordinary zero-delay task to decrement.
+// Do not finish inline or replace this with a per-callback scope.
+//
+// Dropping this token, rejecting its finalizer, or canceling the posted finalizer
+// DOES NOT decrement. Audited notify producers ignore rejected finalizer posts.
+class [[nodiscard]] CoreCloseObserverBatch final {
+ public:
+  CoreCloseObserverBatch(CoreCloseStateHandle state,
+                         CoreCloseObserverChannel channel);
+  ~CoreCloseObserverBatch();
+  CoreCloseObserverBatch(const CoreCloseObserverBatch&) = delete;
+  CoreCloseObserverBatch& operator=(const CoreCloseObserverBatch&) = delete;
+  CoreCloseObserverBatch(CoreCloseObserverBatch&&) = delete;
+  CoreCloseObserverBatch& operator=(CoreCloseObserverBatch&&) = delete;
+
+  [[nodiscard]] bool PostFinalizer(
+      const base::Location& from_here,
+      scoped_refptr<base::SingleThreadTaskRunner> primary_ui_runner);
+
+ private:
+  CoreCloseStateHandle state_;
+  CoreCloseObserverChannel channel_;
+};
+
+}  // namespace arc
+
+#endif  // ARC_BROWSER_CORE_CLOSE_STATE_H_
