+TEST_F(MediaWebContentsObserverTest, VolumeMultiplierIncludesPausedPlayers) {
+  base::test::ScopedFeatureList features;
+  features.InitWithFeatures({media::kInternalMediaSession},
+                           {media_session::features::kMediaSessionService});
+
+  // An empty manager must not retain a multiplier for players added later.
+  constexpr double kEmptyMultiplier = 0.125;
+  media_web_contents_observer().SetVolumeMultiplier(kEmptyMultiplier);
+
+  auto player_host = SetupPlayerHost();
+  auto playing = CreateAndAddPlayer(player_host, 41);
+  auto paused = CreateAndAddPlayer(player_host, 73);
+  SetMediaMetadata(playing.observer, /*has_audio=*/true, /*has_video=*/false);
+  SetMediaMetadata(paused.observer, /*has_audio=*/true, /*has_video=*/false);
+  PlayMedia(playing.observer);
+  PlayMedia(paused.observer);
+  PauseMedia(paused.observer);
+  playing.player->receiver().FlushForTesting();
+  paused.player->receiver().FlushForTesting();
+
+  const size_t playing_before = playing.player->volume_multipliers().size();
+  const size_t paused_before = paused.player->volume_multipliers().size();
+  EXPECT_EQ(std::ranges::find(playing.player->volume_multipliers(),
+                             kEmptyMultiplier),
+            playing.player->volume_multipliers().end());
+  EXPECT_EQ(std::ranges::find(paused.player->volume_multipliers(),
+                             kEmptyMultiplier),
+            paused.player->volume_multipliers().end());
+
+  // Forward the exact values to both players, even outside the [0, 1] range.
+  media_web_contents_observer().SetVolumeMultiplier(1.75);
+  media_web_contents_observer().SetVolumeMultiplier(-0.5);
+  playing.player->receiver().FlushForTesting();
+  paused.player->receiver().FlushForTesting();
+  ASSERT_EQ(playing_before + 2, playing.player->volume_multipliers().size());
+  ASSERT_EQ(paused_before + 2, paused.player->volume_multipliers().size());
+  EXPECT_DOUBLE_EQ(1.75, playing.player->volume_multipliers()[playing_before]);
+  EXPECT_DOUBLE_EQ(-0.5,
+                   playing.player->volume_multipliers()[playing_before + 1]);
+  EXPECT_DOUBLE_EQ(1.75, paused.player->volume_multipliers()[paused_before]);
+  EXPECT_DOUBLE_EQ(-0.5, paused.player->volume_multipliers()[paused_before + 1]);
+
+  // Keep the existing controllers but disable both gates: no Mojo delivery.
+  {
+    base::test::ScopedFeatureList disabled_features;
+    disabled_features.InitWithFeatures(
+        {}, {media::kInternalMediaSession,
+             media_session::features::kMediaSessionService});
+    media_web_contents_observer().SetVolumeMultiplier(0.75);
+    playing.player->receiver().FlushForTesting();
+    paused.player->receiver().FlushForTesting();
+    EXPECT_EQ(playing_before + 2, playing.player->volume_multipliers().size());
+    EXPECT_EQ(paused_before + 2, paused.player->volume_multipliers().size());
+  }
+}
