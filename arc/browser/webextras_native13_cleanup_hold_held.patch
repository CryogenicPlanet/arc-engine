+def cleanup_release_gate(owner, inventory=None, pause=None, ack_reader=None, emit=None, control_sha=None):
+    # Pure dependencies are injectable for private controls. Production uses
+    # only snapshots and parent-created acknowledgement; never process signals.
+    inventory=inventory or actor_inventory
+    pause=pause or (lambda:time.sleep(30))
+    ack=Path(str(STEM)+'.cleanup-release.json')
+    ack_reader=ack_reader or (lambda:json.loads(ack.read_text()))
+    emit=emit or (lambda suffix,value:write_new(str(STEM)+suffix,value))
+    token=uuid.uuid4().hex;rounds=0;held=False;first=True
+    control_sha=control_sha or file_pin(__file__)['sha256']
+    while True:
+        snapshot={'lockOwnerPID':owner,'holdToken':token,'round':rounds,'controlSHA256':control_sha}
+        try:
+            require(ancestor_owner()==owner,'cleanup gate ancestor lock changed')
+            actors=inventory();snapshot['actors']=actors;snapshot['inventoryComplete']=True
+        except (OSError,ValueError,RuntimeError,subprocess.SubprocessError,KeyboardInterrupt) as error:
+            actors=None;snapshot['inventoryComplete']=False;snapshot['error']=str(error)
+        if not held and actors==[]:
+            snapshot['status']='NO_MATCHING_DISPOSABLE_ACTORS_OBSERVED'
+            try:emit('.cleanup-release-verified.json',snapshot);return
+            except (OSError,ValueError,RuntimeError) as error:
+                actors=None;snapshot['error']='cleanup release receipt unavailable: '+str(error)
+        held=True;snapshot['status']='HOLD_PARENT_RECONCILIATION_REQUIRED'
+        if first:
+            try:emit('.cleanup-hold.json',snapshot);first=False
+            except (OSError,ValueError,RuntimeError):pass
+        # Once HOLD has latched, disappearance alone never releases the slot.
+        if actors==[]:
+            try:
+                approval=ack_reader()
+                require(approval=={'controlSHA256':snapshot['controlSHA256'],'lockOwnerPID':owner,'holdToken':token,'releaseWhenGone':True},'parent cleanup-release acknowledgment mismatch')
+                snapshot['status']='PARENT_ACKNOWLEDGED_AND_NO_MATCHING_ACTORS_OBSERVED'
+                emit('.cleanup-release-verified.json',snapshot);return
+            except (OSError,ValueError,RuntimeError):pass
+        rounds+=1
+        try:pause()
+        except KeyboardInterrupt:continue
+
