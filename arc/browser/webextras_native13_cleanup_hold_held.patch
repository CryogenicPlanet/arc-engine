+def parse_actor_inventory(text, root):
+    # Exact existing TS executable-prefix policy; strict parsing adds no
+    # silent skipped rows. Never persist unrelated process commands.
+    prefixes=[]
+    for agent in ('trace156','ours156'):
+        app=root.parent/f'arc/build/ArcModAgent-{agent}.app'
+        prefixes.append((str(app/'Contents/MacOS/Arc'),str(app/'Contents/Frameworks')+'/'))
+    found=[]
+    for index,line in enumerate(text.splitlines()):
+        if not line.strip():continue
+        match=re.fullmatch(r'\s*(\d+)\s+(\d+)\s+(\S+\s+\S+\s+\d+\s+\d{2}:\d{2}:\d{2}\s+\d{4})\s+(.+)',line)
+        require(match is not None,'unparsed process inventory row '+str(index))
+        pid,ppid,born,command=match.groups()
+        if any(command==main or command.startswith(main+' ') or command.startswith(framework) for main,framework in prefixes):
+            found.append({'pid':int(pid),'ppid':int(ppid),'born':born,'command':command})
+    return found
+
+def actor_inventory():
+    result=subprocess.run(['/bin/ps','-ww','-axo','pid=,ppid=,lstart=,command='],check=True,capture_output=True,text=True)
+    return parse_actor_inventory(result.stdout,ROOT)
