+// This helper is deliberately held: no transport consumer routes events here.
+// The transport itself must not call app/KVO or mutate a tab strip while the
+// original viewDidMoveToWindow stack may be inside a native tab mutation.
+void QueueKnownStateZeroWindowAttachment(ArcWebContents* wrapper,
+                                         content::WebContents* contents,
+                                         gfx::NativeWindow window) {
+  if (!contents || [wrapper webContents] != contents) { return; }
+  __weak ArcWebContents* weak_owner = wrapper;
+  const auto native = contents->GetWeakPtr();
+  content::GetUIThreadTaskRunner({})->PostNonNestableTask(FROM_HERE,
+      base::BindOnce([](void (^work)()) { work(); }, ^{
+    if (!native || native->IsBeingDestroyed()) { return; }
+    ArcWebContents* owner __attribute__((objc_precise_lifetime)) = weak_owner;
+    if (!owner || [owner webContents] != native.get()) { return; }
+    auto browser = arc::CoreWindowBrowserForContents(native.get());
+    if (!browser) { return; }
+    auto matching = arc::CoreWindowBrowserWithWindow(window);
+    if (matching && matching.get() != browser.get()) {
+      // HOLD: transfer must preserve TabModel and canonical WebContents, with
+      // rollback if synchronous source notifications close the destination.
+      return;
+    }
+    auto* host_window = static_cast<arc::ArcBrowserWindow*>(browser->GetWindow());
+    if (!host_window->GetNativeWindow().GetNativeNSWindow()) {
+      host_window->SetNativeWindow(window);
+    }
+    // Chromium 156 DCHECKs this API on visible pages, which are never frozen.
+    if (native->GetVisibility() != content::Visibility::VISIBLE) {
+      native->SetPageFrozen(false);
+    }
+    if (!native || !browser || browser->IsDeleteScheduled() ||
+        arc::CoreWindowBrowserForContents(native.get()).get() != browser.get()) {
+      return;
+    }
+    // Once accepted, this property task depends only on its weak ObjC owner.
+    // It remains eligible after native contents teardown, like observer 0x38.
+    PostCoreUI(^{
+      ArcWebContents* current __attribute__((objc_precise_lifetime)) = weak_owner;
+      if (current) { current.state = 0; }
+    });
+  }));
+}
