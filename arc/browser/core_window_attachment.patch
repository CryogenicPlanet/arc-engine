+    content::WebContents* contents);
+base::WeakPtr<BrowserWindowInterface> CoreWindowBrowserWithWindow(
+    gfx::NativeWindow window);
+
+// Only for an independently captured native state-zero attachment event.
+// HOLD: no transport consumer is installed by this proposal. Transfer rollback
