+
+bool IsCoreWindowBrowser(BrowserWindowInterface* browser) {
+  auto& browsers = CoreWindowBrowsers();
+  for (auto it = browsers.begin(); it != browsers.end();) {
+    if (!*it) {
+      it = browsers.erase(it);
+    } else if (it->get() == browser) {
+      return true;
+    } else {
+      ++it;
+    }
+  }
+  return false;
+}
