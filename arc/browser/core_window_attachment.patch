+namespace arc {
+void RegisterCoreWindowBrowser(BrowserWindowInterface* browser) {
+  if (browser && !IsCoreWindowBrowser(browser)) {
+    CoreWindowBrowsers().push_back(browser->GetWeakPtr());
+  }
+}
+
+base::WeakPtr<BrowserWindowInterface> CoreWindowBrowserForContents(
+    content::WebContents* contents) {
+  auto* tab = contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!browser || browser->IsDeleteScheduled() || !IsCoreWindowBrowser(browser)) {
+    return {};
+  }
+  return browser->GetWeakPtr();
+}
+
+base::WeakPtr<BrowserWindowInterface> CoreWindowBrowserWithWindow(
+    gfx::NativeWindow window) {
+  base::WeakPtr<BrowserWindowInterface> result;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (!browser->IsDeleteScheduled() && IsCoreWindowBrowser(browser) &&
+            browser->GetWindow()->GetNativeWindow().GetNativeNSWindow() ==
+                window.GetNativeNSWindow()) {
+          result = browser->GetWeakPtr();
+          return false;
+        }
+        return true;
+      });
+  return result;
+}
