diff --git a/chrome/browser/devtools/devtools_ui_bindings.cc b/chrome/browser/devtools/devtools_ui_bindings.cc
--- a/chrome/browser/devtools/devtools_ui_bindings.cc
+++ b/chrome/browser/devtools/devtools_ui_bindings.cc
@@ -39,6 +39,7 @@
 #include "build/branding_buildflags.h"
 #include "build/build_config.h"
 #include "chrome/browser/about_flags.h"
+#include "chrome/browser/arcmod/arcmod_hooks.h"
 #include "chrome/browser/browser_process.h"
 #include "chrome/browser/devtools/aida_service_handler.h"
 #include "chrome/browser/devtools/devtools_file_watcher.h"
@@ -2403,6 +2404,20 @@
   if (!agent_host_) {
     return;
   }
+  if (auto hook = arcmod::GetDevToolsFrontendMessageHook(); !hook.is_null()) {
+    // The hook can close the frontend and destroy these bindings. Own the
+    // message across reentry, and do not dispatch through a dead binding/host.
+    const std::string owned_message(message);
+    scoped_refptr<content::DevToolsAgentHost> original_host = agent_host_;
+    auto weak_this = weak_factory_.GetWeakPtr();
+    hook.Run(web_contents_, owned_message);
+    if (!weak_this || weak_this->agent_host_ != original_host) {
+      return;
+    }
+    original_host->DispatchProtocolMessage(
+        weak_this.get(), base::as_byte_span(owned_message));
+    return;
+  }
   agent_host_->DispatchProtocolMessage(this, base::as_byte_span(message));
 }
 
