+// Observes a loaded DevTools frontend's explicit activation request. Arc's app
+// can focus its hosted frontend; Chrome's ordinary activation still follows if
+// the hook leaves the window alive and loaded. This does not report show mode.
+using DevToolsFocusHook =
+    base::RepeatingCallback<void(content::WebContents* inspected)>;
+inline DevToolsFocusHook& GetDevToolsFocusHook() {
+  static base::NoDestructor<DevToolsFocusHook> hook;
+  return *hook;
+}
