+// Observes a protocol command sent by the DevTools frontend while attached to
+// an agent. Runs synchronously before dispatch. |message| is borrowed only for
+// the duration of the hook; retain a copy if needed. This is not a backend reply
+// or a command sent by an external DevTools client.
+using DevToolsFrontendMessageHook = base::RepeatingCallback<void(
+    content::WebContents* frontend,
+    std::string_view message)>;
+inline DevToolsFrontendMessageHook& GetDevToolsFrontendMessageHook() {
+  static base::NoDestructor<DevToolsFrontendMessageHook> hook;
+  return *hook;
+}
+
+// Observes a loaded DevTools frontend's explicit activation request. Arc's app
+// can focus its hosted frontend; Chrome's ordinary activation still follows if
+// the hook leaves the window alive and loaded. This does not report show mode.
+using DevToolsFocusHook =
+    base::RepeatingCallback<void(content::WebContents* inspected)>;
+inline DevToolsFocusHook& GetDevToolsFocusHook() {
+  static base::NoDestructor<DevToolsFocusHook> hook;
+  return *hook;
+}
