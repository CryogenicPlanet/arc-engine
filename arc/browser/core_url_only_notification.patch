+namespace arc {
+void QueueCoreBrowserURLOnlyNotification(content::WebContents* contents,
+                                         ArcWebContents* canonical_contents) {
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  if (!CoreExistingWebContentsWrapperMatchesNative(contents, canonical_contents)) {
+    return;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!browser || browser->IsDeleteScheduled()) { return; }
+  auto* holder = ExistingArcBrowserHolder(browser);
+  ArcBrowser* owner __attribute__((objc_precise_lifetime)) =
+      holder ? holder->wrapper : nil;
+  if (!owner) { return; }
+  const auto weak_native = contents->GetWeakPtr();
+  const auto weak_browser = browser->GetWeakPtr();
+  __weak ArcBrowser* weak_owner = owner;
+  __weak ArcWebContents* weak_contents = canonical_contents;
+  content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(
+      [](void (^work)()) { work(); }, ^{
+    if (!weak_native || !weak_browser || weak_browser->IsDeleteScheduled()) {
+      return;
+    }
+    ArcBrowser* current_owner __attribute__((objc_precise_lifetime)) = weak_owner;
+    ArcWebContents* current_contents __attribute__((objc_precise_lifetime)) = weak_contents;
+    if (!current_owner || !current_contents) { return; }
+    auto* current_tab = tabs::TabInterface::MaybeGetFromContents(weak_native.get());
+    if (!current_tab ||
+        current_tab->GetBrowserWindowInterface() != weak_browser.get()) {
+      return;
+    }
+    auto* current_holder = ExistingArcBrowserHolder(weak_browser.get());
+    if (!current_holder || current_holder->wrapper != current_owner ||
+        !CoreExistingWebContentsWrapperMatchesNative(weak_native.get(),
+                                                     current_contents)) {
+      return;
+    }
+    // Notification observers may synchronously detach/destroy everything above.
+    // Terminal dispatch: no borrowed native/holder/tab access follows.
+    NotifyTabChange(current_owner, current_contents, @"updated");
+  }));
+}
+}  // namespace arc
