+namespace arc {
+bool CoreExistingWebContentsWrapperMatchesNative(
+    content::WebContents* contents, ArcWebContents* owner) {
+  if (!contents || !owner) { return false; }
+  auto* data = ArcContentsData::FromWebContents(contents);
+  if (!data) { return false; }
+  ArcWebContents* canonical __attribute__((objc_precise_lifetime)) =
+      data->wrapper ?: data->weak_wrapper;
+  return canonical == owner && [owner coreMatchesNativeContents:contents];
+}
