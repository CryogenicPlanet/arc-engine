+// Copyright 2026 ArcMod. Private existing-identity URL notification bridge.
+#ifndef ARC_BROWSER_CORE_BROWSER_NOTIFICATIONS_H_
+#define ARC_BROWSER_CORE_BROWSER_NOTIFICATIONS_H_
+
+#ifdef __OBJC__
+@class ArcWebContents;
+namespace content { class WebContents; }
+namespace arc {
+// UI only, valid UI-local native borrow. Existing-only canonical mapping check;
+// private direct native match, no public getter/app call or wrapper creation.
+bool CoreExistingWebContentsWrapperMatchesNative(
+    content::WebContents* contents, ArcWebContents* owner);
+
+// Called ONLY for exact URL-only native invalidation, immediately after queuing
+// its existing URL/navigationID property update. Posts one package notification
+// task using weak native+ObjC identities. Native liveness gates ONLY the new
+// notification, never the preexisting property task. Requires an existing hosted
+// ArcBrowserWindow holder, using the SAME contract as +wrapperForBrowser:.
+// Delivery rejects closed/reassociated/noncanonical targets and dispatches the
+// existing tabs-changed "updated" event terminally. No public API or registry.
+void QueueCoreBrowserURLOnlyNotification(content::WebContents* contents,
+                                         ArcWebContents* canonical_contents);
+}  // namespace arc
+#endif
+#endif  // ARC_BROWSER_CORE_BROWSER_NOTIFICATIONS_H_
