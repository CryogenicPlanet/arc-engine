+
+// Original Arc does not capture these app-owned internal pages. DomainIs is
+// intentional: its hostname-boundary semantics also apply to subdomains.
+bool IsArcInternalPage(const GURL& url) {
+  return url.SchemeIs("chrome") &&
+         (url.DomainIs("start-page") || url.DomainIs("assistant") ||
+          url.DomainIs("native-bookmarks") || url.DomainIs("skills-manager"));
+}
 
