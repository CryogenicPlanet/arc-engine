+def compare_records(inputs, snapshot, left, right, report, log):
+    inputs.verify(snapshot)
+    try:
+        # The canonical scenario comparator always uses its DEFAULT caller policy.
+        return run_command([sys.executable, '-B', str(snapshot / 'tests/recorder/diff.py'),
+                            str(left), str(right), '--json', str(report)], log)
+    finally:
+        inputs.verify(snapshot)
+
+
+def load_comparison_inputs():
+    # Execute reviewed source bytes, never an unchecked Python bytecode cache.
+    path = ROOT / 'arc/browser/webextras_fixture_inputs.py'
+    before = identity(path)
+    source = path.read_bytes()
+    require(before['sha256'] == hashlib.sha256(source).hexdigest() ==
+            'f60537a31119b2b50f802f0ce0b9257ee12a09dd0f1edc3a639c03a3e5a64fd9',
+            'comparison freezer differs from reviewed f605 source')
+    module = types.ModuleType('webextras_canonical_comparison_inputs')
+    module.__file__ = str(path)
+    exec(compile(source, str(path), 'exec'), module.__dict__)
+    require(identity(path) == before, 'comparison freezer changed while loading')
+    return module
+
