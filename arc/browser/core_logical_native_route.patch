+CoreLogicalWebContentsHandle FindCoreLogicalForNativeWebContents(
+    content::WebContents* contents) {
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  if (!contents) { return {}; }
+  auto* data = ArcContentsData::FromWebContents(contents);
+  if (!data) { return {}; }
+  auto logical = data->logical_route.lock();
+  if (!logical || logical->GetNative() != contents) { return {}; }
+  return logical;
+}
+
+bool TryInstallInitialCoreLogicalForNativeWebContents(
+    content::WebContents* contents,
+    const CoreLogicalWebContentsHandle& logical) {
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  if (!contents || !logical || logical->GetNative() != contents) { return false; }
+  const auto state = logical->GetCloseState();
+  if (!state) { return false; }
+  auto* data = ArcContentsData::FromWebContents(contents);
+  ArcWebContents* strong_owner __attribute__((objc_precise_lifetime)) = nil;
+  ArcWebContents* weak_owner __attribute__((objc_precise_lifetime)) = nil;
+  if (data) {
+    const CoreLogicalWebContentsWeakHandle empty;
+    const auto& route = data->logical_route;
+    const bool was_published = route.owner_before(empty) || empty.owner_before(route);
+    if (was_published) {
+      // Compare control identity even when the former root has expired.
+      if (route.owner_before(logical) || logical.owner_before(route)) { return false; }
+      const auto installed = route.lock();
+      if (!installed || installed.get() != logical.get()) { return false; }
+    }
+    const auto matches_state = [&](ArcWebContents* owner) {
+      if (!owner) { return true; }
+      const auto facade_state = [owner coreCloseStateForNativeContents:contents];
+      return facade_state && facade_state.get() == state.get() &&
+          !facade_state.owner_before(state) && !state.owner_before(facade_state);
+    };
+    strong_owner = data->wrapper;
+    weak_owner = data->weak_wrapper;
+    if (!matches_state(strong_owner) || !matches_state(weak_owner)) { return false; }
+  }
+  // Factory-time publication violates the bare library's construction contract.
+  // Accessors CHECK their slots; require BOTH actual functional peers completed.
+  CHECK(logical->GetMediaPeer());
+  CHECK(logical->GetDevToolsPeer());
+  if (!data) { data = ArcContentsData::GetOrCreateForWebContents(contents); }
+  data->logical_route = logical;
+  return true;
+}
