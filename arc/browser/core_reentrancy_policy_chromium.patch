+// Arc's native validator caches its application mode on first initialization.
+// Until configured, keep Chrome's strict behavior. All accesses are UI-sequence.
+namespace internal {
+inline std::unique_ptr<const bool>& HostAppProductionModeCache() {
+  static base::NoDestructor<std::unique_ptr<const bool>> mode;
+  return *mode;
+}
+}  // namespace internal
+inline void InitializeHostAppProductionMode(bool is_production) {
+  auto& mode = internal::HostAppProductionModeCache();
+  if (!mode) { mode = std::make_unique<const bool>(is_production); }
+}
+inline bool HostAppProductionModeAllowsReentrancy() {
+  const auto& mode = internal::HostAppProductionModeCache();
+  return mode ? *mode : false;
+}
+
 }  // namespace arcmod
 
