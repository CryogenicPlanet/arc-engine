+WebextrasDevToolsPeer::WebextrasDevToolsPeer(CoreLogicalWebContentsWeakHandle logical)
+{
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  impl_ = std::make_unique<Impl>(std::move(logical), weak_factory_.GetWeakPtr());
+}
+WebextrasDevToolsPeer::~WebextrasDevToolsPeer() {
+  CHECK(content::BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  // Retire only borrowed observation (no callouts), then invalidate before
+  // functional client/ObjC payload teardown.
+  impl_->Retire();
+  weak_factory_.InvalidateWeakPtrs();
+}
+void WebextrasDevToolsPeer::AttachToWebContents(base::WeakPtr<content::WebContents> contents) {
+  impl_->Attach(std::move(contents));
+}
+void WebextrasDevToolsPeer::RetireFromWebContents() { impl_->Retire(); }
+base::WeakPtr<WebextrasDevToolsPeer> WebextrasDevToolsPeer::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+WebextrasDevToolsPeer::Impl& WebextrasDevToolsPeer::state() { return *impl_; }
+CoreDevToolsPeerFactory MakeWebextrasDevToolsPeerFactory() {
+  return base::BindOnce([](CoreLogicalWebContentsWeakHandle logical)
+      -> std::shared_ptr<CoreDevToolsPeer> {
+    return std::make_shared<WebextrasDevToolsPeer>(std::move(logical));
+  });
+}
+void WebextrasDevToolsPeer::Impl::InstallHooks() {
+  arcmod::GetDevToolsShowHook() = base::BindRepeating(
+      [](content::WebContents* inspected, content::WebContents* frontend, bool docked) {
+        auto peer = PeerForContents(inspected);
+        if (peer) { peer->state().didShowFrontend(frontend, docked); }
+      });
+  arcmod::GetDevToolsFrontendCreatedHook() = base::BindRepeating(
+      [](content::WebContents* inspected, content::WebContents* frontend) {
+        auto peer = PeerForContents(inspected);
+        if (peer) { peer->state().didCreateFrontend(frontend); }
+      });
+  arcmod::GetDevToolsDockPositionHook() = base::BindRepeating(
+      [](content::WebContents* inspected, content::WebContents*, const std::string& side) {
+        auto peer = PeerForContents(inspected);
+        if (peer) { peer->state().requestedDockPosition(side); }
+      });
+  arcmod::GetDevToolsInspectModeHook() = base::BindRepeating(
+      [](content::WebContents* inspected, content::WebContents*, const std::string& mode) {
+        auto peer = PeerForContents(inspected);
+        if (peer) { peer->state().inspectModeChanged(mode); }
+      });
+  arcmod::GetDevToolsFocusHook() = base::BindRepeating(
+      [](content::WebContents* inspected) {
+        auto peer = PeerForContents(inspected);
+        if (peer) { peer->state().frontendRequestedFocus(); }
+      });
+}
