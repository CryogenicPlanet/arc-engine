+def patch_paths(content, patch, owners):
+    require(b'\0' not in content and b'\x1b' not in content, 'binary/colored patch is unsupported')
+    sections = []
+    for line in content.splitlines():
+        if line.startswith(b'diff --git '):
+            fields = line.decode().split()
+            require(len(fields) == 4 and fields[2].startswith('a/') and fields[3].startswith('b/'), 'unsupported diff header')
+            old, new = path_name(fields[2][2:]), path_name(fields[3][2:])
+            require(old == new, 'diff source/destination ownership mismatch')
+            require(owners.get(old) == patch, 'patch ownership mismatch: '+old)
+            require(not any(section['path'] == old for section in sections), 'duplicate diff section')
+            sections.append(dict(path=old, old=[], new=[], addition=False))
+            continue
+        require(sections, 'patch lacks diff header')
+        section = sections[-1]
+        if line.startswith((b'old mode ', b'new mode ', b'new file mode ')):
+            require(line.split()[-1] in (b'100644', b'100755'), 'unsupported patch file mode')
+            if line.startswith(b'new file mode '):section['addition'] = True
+        require(not line.startswith((b'deleted file mode ', b'rename from ', b'rename to ', b'copy from ', b'copy to ', b'Binary files ', b'GIT binary patch')), 'unsupported patch operation')
+        if line.startswith(b'--- '):section['old'].append(line[4:].decode())
+        if line.startswith(b'+++ '):section['new'].append(line[4:].decode())
+    require(sections, 'patch has no file sections')
+    for section in sections:
+        path = section['path']
+        if section['old'] or section['new']:
+            require(section['old'] == ['/dev/null' if section['addition'] else 'a/'+path] and section['new'] == ['b/'+path], 'file header ownership mismatch')
+    return {section['path'] for section in sections}
