+std::shared_ptr<WebextrasMediaSource> GetWebextrasMediaSourceForNative(
+    content::WebContents* contents) {
+  if (!contents) { return nullptr; }
+  auto* data = static_cast<WebextrasMediaNativeSource*>(
+      contents->GetUserData(&kWebextrasMediaNativeSourceKey));
+  return data ? data->source.lock() : nullptr;
+}
+void WebextrasMediaSource::AttachToWebContents(
+    base::WeakPtr<content::WebContents> contents) {
+  auto logical = logical_.lock();
+  CHECK(logical && contents && !observer_);
+  // Accessor CHECK requires construction to have installed the actual peer.
+  CHECK(logical->GetMediaPeer().get() == this);
+  CHECK(logical->GetDevToolsPeer());
+  CHECK(logical->GetNative() == contents.get());
+  CHECK(!GetWebextrasMediaSourceForNative(contents.get()));
+  contents_ = contents;
+  contents->SetUserData(&kWebextrasMediaNativeSourceKey,
+      std::make_unique<WebextrasMediaNativeSource>(weak_from_this()));
+  arcmod::GetVideoOverlayWindowHook() = base::BindRepeating(&arc::CreateVideoOverlayWindow);
+  observer_ = std::make_unique<ArcMediaObserver>(
+      contents.get(), content::MediaSession::Get(contents.get()), weak_from_this());
+}
+void WebextrasMediaSource::RetirePhysical() {
+  // Unchanged-attachment normal path only; no invented post-call generation gate.
+  PiPDestroyed();
+  if (contents_) {
+    contents_->RemoveUserData(&kWebextrasMediaNativeSourceKey);
+  }
+  if (observer_) { observer_->Detach(); }
+  contents_.reset();
+}
 }
 
