+struct ArcEncodedColorFilter {
+  base::AlignedHeapArray<uint8_t> memory;
+  size_t size = 0;
+};
+
+ArcEncodedColorFilter EncodeArcColorFilter(sk_sp<ColorFilter> color_filter,
+                                          bool security_constraints) {
+  auto wrapped = sk_make_sp<ColorFilterPaintFilter>(std::move(color_filter),
+                                                   nullptr);
+  const size_t predicted = PaintOpWriter::SerializedSize(static_cast<const PaintFilter*>(wrapped.get()));
+  ArcEncodedColorFilter encoded{
+      PaintOpWriter::AllocateAlignedBuffer(predicted), 0};
+  TestOptionsProvider options;
+  PaintOpWriter writer(encoded.memory.as_span(), options.serialize_options(),
+                       security_constraints);
+  writer.Write(wrapped.get(), SkM44());
+  encoded.size = writer.size();
+  EXPECT_EQ(encoded.size, predicted);
+  EXPECT_GT(encoded.size, 0u);
+  return encoded;
+}
+
+sk_sp<ColorFilter> DecodeArcColorFilter(base::span<const uint8_t> bytes,
+                                       bool security_constraints,
+                                       bool* valid) {
+  TestOptionsProvider options;
+  PaintOpReader reader(bytes, options.deserialize_options(),
+                       security_constraints);
+  sk_sp<PaintFilter> wrapped;
+  reader.Read(&wrapped);
+  *valid = reader.valid();
+  if (!*valid || !wrapped) {
+    return nullptr;
+  }
+  EXPECT_EQ(reader.remaining_bytes(), 0u);
+  EXPECT_EQ(wrapped->type(), PaintFilter::Type::kColorFilter);
+  if (wrapped->type() != PaintFilter::Type::kColorFilter) {
+    return nullptr;
+  }
+  return static_cast<ColorFilterPaintFilter*>(wrapped.get())->color_filter();
+}
