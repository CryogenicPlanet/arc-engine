+class HSLAMatrixColorFilter final : public ColorFilter {
+ public:
+  explicit HSLAMatrixColorFilter(const float matrix[20])
+      : ColorFilter(Type::kHSLAMatrix, SkColorFilters::HSLAMatrix(matrix)) {
+    for (size_t i = 0; i < matrix_.size(); ++i) {
+      // SAFETY: the factory requires exactly twenty matrix elements.
+      matrix_[i] = UNSAFE_BUFFERS(matrix[i]);
+    }
+  }
+
+ private:
+  size_t SerializedDataSize() const override {
+    return PaintOpWriter::SerializedSizeOfElements(matrix_.data(), matrix_.size());
+  }
+  void SerializeData(PaintOpWriter& writer) const override {
+    // HSLA filters cannot be recovered with asAColorMatrix (RGBA only).
+    for (float value : matrix_) {
+      writer.Write(value);
+    }
+  }
+  std::array<float, 20> matrix_;
+};
