+void ExpectArcColorNear(const SkColor4f& actual, const SkColor4f& expected) {
+  EXPECT_NEAR(actual.fR, expected.fR, 1e-5f);
+  EXPECT_NEAR(actual.fG, expected.fG, 1e-5f);
+  EXPECT_NEAR(actual.fB, expected.fB, 1e-5f);
+  EXPECT_NEAR(actual.fA, expected.fA, 1e-5f);
