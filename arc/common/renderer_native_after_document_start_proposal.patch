+
+void WebViewImpl::SetArcColorFilter(
+    const std::optional<std::array<float, 20>>& matrix) {
+  if (!matrix) {
+    page_->SetArcColorFilter(nullptr);
+    return;
+  }
+  std::array<uint8_t, 256> alpha, rgb;
+  for (size_t i = 0; i < alpha.size(); ++i) {
+    alpha[i] = static_cast<uint8_t>(i);
+    rgb[i] = static_cast<uint8_t>(std::min(i, size_t{254}));
+  }
+  auto table = cc::ColorFilter::MakeTableARGB(alpha.data(), rgb.data(),
+                                              rgb.data(), rgb.data());
+  page_->SetArcColorFilter(cc::ColorFilter::MakeCompose(
+      cc::ColorFilter::MakeHSLAMatrix(matrix->data()), std::move(table)));
+}
