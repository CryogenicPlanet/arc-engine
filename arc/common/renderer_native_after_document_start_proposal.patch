+class ComposeColorFilter final : public ColorFilter {
+ public:
+  ComposeColorFilter(sk_sp<ColorFilter> outer,
+                     sk_sp<ColorFilter> inner,
+                     sk_sp<SkColorFilter> composed)
+      : ColorFilter(Type::kCompose, std::move(composed)),
+        outer_(std::move(outer)), inner_(std::move(inner)) {}
+
+ private:
+  size_t SerializedDataSize() const override {
+    base::CheckedNumeric<size_t> size =
+        PaintOpWriter::SerializedSize(outer_.get());
+    size += PaintOpWriter::SerializedSize(inner_.get());
+    return size.ValueOrDie();
+  }
+  void SerializeData(PaintOpWriter& writer) const override {
+    writer.Write(outer_.get());
+    writer.Write(inner_.get());
+  }
+  sk_sp<ColorFilter> outer_;
+  sk_sp<ColorFilter> inner_;
+};
