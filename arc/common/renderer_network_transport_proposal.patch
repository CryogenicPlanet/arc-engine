+
+namespace network { struct ResourceRequest; }
+namespace arc {
+
+class NetworkExclusions final : public base::RefCountedThreadSafe<NetworkExclusions> {
+ public:
+  explicit NetworkExclusions(const std::vector<std::string>& origins);
+  bool Contains(const url::Origin& origin) const;
+ private:
+  friend class base::RefCountedThreadSafe<NetworkExclusions>;
+  ~NetworkExclusions();
+  const std::vector<url::Origin> origins_;
+};
+
+// Immutable rule bytes are thread-safe to retain. Upstream MemoryMappedRuleset
+// and its weak/sequence-local caches must never be retained by worker throttles.
+class NetworkRulesBroker final : public base::RefCountedThreadSafe<NetworkRulesBroker> {
+ public:
+  NetworkRulesBroker();
+  void SetRules(scoped_refptr<const base::RefCountedMemory> bytes, uint64_t ruleset_id);
+  void SetExclusions(const std::vector<std::string>& origins, uint64_t revision);
+  scoped_refptr<const NetworkExclusions> SnapshotExclusions() const;
+  bool ShouldDisallow(const network::ResourceRequest& request,
+                     const NetworkExclusions& exclusions,
+                     bool browser_mode,
+                     base::OnceClosure on_disallowed = base::OnceClosure()) const;
+ private:
+  friend class base::RefCountedThreadSafe<NetworkRulesBroker>;
+  ~NetworkRulesBroker();
+  mutable base::Lock lock_;
+  scoped_refptr<const base::RefCountedMemory> rules_ GUARDED_BY(lock_);
+  scoped_refptr<const NetworkExclusions> exclusions_ GUARDED_BY(lock_);
+  uint64_t ruleset_id_ GUARDED_BY(lock_) = 0;
+  uint64_t exclusions_revision_ GUARDED_BY(lock_) = 0;
+  bool has_rules_ GUARDED_BY(lock_) = false;
+  bool has_exclusions_ GUARDED_BY(lock_) = false;
+};
+}  // namespace arc
