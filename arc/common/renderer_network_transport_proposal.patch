+// Copyright 2026 ArcMod. Provider wrapper usable on main, worker and fetch threads.
+#include "arc/renderer/network_throttle.h"
+
+#include <atomic>
+#include <utility>
+
+#include "arc/common/network_rules.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "net/base/net_errors.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+#include "third_party/blink/public/platform/url_loader_throttle_provider.h"
+
+namespace arc {
+namespace {
+constinit std::atomic<bool> network_enabled{false};
+class NetworkThrottle final : public blink::URLLoaderThrottle {
+ public:
+  NetworkThrottle(scoped_refptr<NetworkRulesBroker> broker, bool browser_mode)
+      : broker_(std::move(broker)), exclusions_(broker_->SnapshotExclusions()),
+        browser_mode_(browser_mode) {}
+  void WillStartRequest(network::ResourceRequest* request, bool*) override {
+    // Completion reporting owns count updates. The synchronous callback keeps
+    // cancellation inside the dealer lock, as in native WillStart.
+    broker_->ShouldDisallow(*request, *exclusions_, browser_mode_, base::BindOnce(
+        [](blink::URLLoaderThrottle::Delegate* delegate) {
+          delegate->CancelWithError(net::ERR_BLOCKED_BY_CONTENT_BLOCKER);
+        }, base::Unretained(delegate_.get())));
+    // No member access after cancellation. Redirect/response hooks remain noops.
+
+  }
+ private:
+  const scoped_refptr<NetworkRulesBroker> broker_;
+  const scoped_refptr<const NetworkExclusions> exclusions_;
+  const bool browser_mode_;
+};
+class NetworkProvider final : public blink::URLLoaderThrottleProvider {
+ public:
+  NetworkProvider(std::unique_ptr<blink::URLLoaderThrottleProvider> upstream,
+                  scoped_refptr<NetworkRulesBroker> broker)
+      : upstream_(std::move(upstream)), broker_(std::move(broker)) {}
+  std::unique_ptr<blink::URLLoaderThrottleProvider> Clone() override {
+    return std::make_unique<NetworkProvider>(upstream_->Clone(), broker_);
+  }
+  std::vector<std::unique_ptr<blink::URLLoaderThrottle>> CreateThrottles(
+      base::optional_ref<const blink::LocalFrameToken> token,
+      const network::ResourceRequest& request) override {
+    auto throttles = upstream_->CreateThrottles(token, request);
+    throttles.push_back(CreateNetworkThrottle(broker_, false));
+    return throttles;
+  }
+  void SetOnline(bool online) override { upstream_->SetOnline(online); }
+ private:
+  std::unique_ptr<blink::URLLoaderThrottleProvider> upstream_;
+  const scoped_refptr<NetworkRulesBroker> broker_;
+};
+}  // namespace
+void EnableRendererNetworkThrottle() {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app")) {
+    network_enabled.store(true, std::memory_order_release);
+  }
+}
+bool RendererNetworkThrottleEnabled() {
+  return network_enabled.load(std::memory_order_acquire);
+}
+scoped_refptr<NetworkRulesBroker> GetProcessNetworkRulesBroker() {
+  static base::NoDestructor<scoped_refptr<NetworkRulesBroker>> broker(
+      base::MakeRefCounted<NetworkRulesBroker>());
+  return *broker;
+}
+std::unique_ptr<blink::URLLoaderThrottleProvider> WrapRendererNetworkThrottleProvider(
+    std::unique_ptr<blink::URLLoaderThrottleProvider> upstream) {
+  if (!RendererNetworkThrottleEnabled()) {
+    return upstream;
+  }
+  return std::make_unique<NetworkProvider>(std::move(upstream), GetProcessNetworkRulesBroker());
+}
+std::unique_ptr<blink::URLLoaderThrottle> CreateNetworkThrottle(
+    scoped_refptr<NetworkRulesBroker> broker, bool browser_mode) {
+  return std::make_unique<NetworkThrottle>(std::move(broker), browser_mode);
+}
+}  // namespace arc
