+namespace arc {
+namespace {
+std::vector<url::Origin> ParseOrigins(const std::vector<std::string>& serialized) {
+  std::vector<url::Origin> origins;
+  for (const auto& value : serialized) {
+    origins.push_back(url::Origin::Create(GURL(value)));
+  }
+  return origins;
+}
+bool IsInternalScheme(std::string_view scheme) {
+  return scheme == "chrome-extension" || scheme == "devtools" ||
+         scheme == "chrome" || scheme == "view-source";
+}
+url_pattern_index::proto::ElementType ElementType(network::mojom::RequestDestination destination) {
+  using Destination = network::mojom::RequestDestination;
+  using namespace url_pattern_index::proto;
+  switch (destination) {
+    case Destination::kAudio:
+    case Destination::kVideo:
+    case Destination::kTrack: return ELEMENT_TYPE_MEDIA;
+    case Destination::kEmbed:
+    case Destination::kObject: return ELEMENT_TYPE_OBJECT;
+    case Destination::kFont: return ELEMENT_TYPE_FONT;
+    case Destination::kDocument:
+    case Destination::kFrame:
+    case Destination::kIframe:
+    case Destination::kFencedframe: return ELEMENT_TYPE_SUBDOCUMENT;
+    case Destination::kImage: return ELEMENT_TYPE_IMAGE;
+    case Destination::kScript: return ELEMENT_TYPE_SCRIPT;
+    case Destination::kStyle: return ELEMENT_TYPE_STYLESHEET;
+    case Destination::kWebBundle: return ELEMENT_TYPE_WEBBUNDLE;
+    default: return ELEMENT_TYPE_OTHER;
+  }
+}
+}  // namespace
+
+NetworkExclusions::NetworkExclusions(const std::vector<std::string>& origins)
+    : origins_(ParseOrigins(origins)) {}
+NetworkExclusions::~NetworkExclusions() = default;
+bool NetworkExclusions::Contains(const url::Origin& origin) const {
+  return origin.scheme() == "chrome-extension" ||
+         std::ranges::any_of(origins_, [&origin](const auto& excluded) {
+           return net::registry_controlled_domains::SameDomainOrHost(
+               origin, excluded,
+               net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+         });
+}
+NetworkRulesBroker::NetworkRulesBroker()
+    : exclusions_(base::MakeRefCounted<NetworkExclusions>(std::vector<std::string>())) {}
+NetworkRulesBroker::~NetworkRulesBroker() = default;
+void NetworkRulesBroker::SetRules(scoped_refptr<const base::RefCountedMemory> bytes,
+                                  uint64_t ruleset_id) {
+  base::AutoLock lock(lock_);
+  if (has_rules_ && ruleset_id <= ruleset_id_) {
+    return;
+  }
+  has_rules_ = true;
+  ruleset_id_ = ruleset_id;
+  rules_ = std::move(bytes);
+}
+void NetworkRulesBroker::SetExclusions(const std::vector<std::string>& origins,
+                                      uint64_t revision) {
+  auto snapshot = base::MakeRefCounted<NetworkExclusions>(origins);
+  base::AutoLock lock(lock_);
+  if (has_exclusions_ && revision <= exclusions_revision_) {
+    return;
+  }
+  has_exclusions_ = true;
+  exclusions_revision_ = revision;
+  exclusions_ = std::move(snapshot);
+}
+scoped_refptr<const NetworkExclusions> NetworkRulesBroker::SnapshotExclusions() const {
+  base::AutoLock lock(lock_);
+  return exclusions_;
+}
+bool NetworkRulesBroker::ShouldDisallow(const network::ResourceRequest& request,
+                                        const NetworkExclusions& exclusions,
+                                        bool browser_mode,
+                                        base::OnceClosure on_disallowed) const {
+  const auto origin = request.request_initiator.value_or(url::Origin::Create(request.url));
+  subresource_filter::FirstPartyOrigin first_party(origin);
+  if (browser_mode && request.destination == network::mojom::RequestDestination::kDocument &&
+      first_party.IsThirdParty(request.url)) {
+    return false;
+  }
+  if (exclusions.Contains(origin) || IsInternalScheme(origin.scheme())) {
+    return false;
+  }
+  if (request.trusted_params) {
+    const auto& top = request.trusted_params->isolation_info.top_frame_origin();
+    if (top && exclusions.Contains(*top)) {
+      return false;
+    }
+  }
+  // Native carries Blink's independent TopFrameOrigin snapshot even when
+  // trusted isolation info is absent (for example ordinary renderer loads).
+  if (request.top_frame_origin && exclusions.Contains(*request.top_frame_origin)) {
+    return false;
+  }
+  if (IsInternalScheme(request.url.scheme()) || request.url.SchemeIs("filesystem") ||
+      request.url.SchemeIs("about") || request.url.SchemeIs("blob") || request.url.SchemeIs("data")) {
+    return false;
+  }
+  // Current rules are selected at WillStart, whereas exclusions were captured
+  // when the throttle was constructed. Keep update exclusion and matching under
+  // the dealer lock, but instantiate mutable upstream caches on this sequence.
+  base::AutoLock lock(lock_);
+  if (!rules_) {
+    return false;
+  }
+  subresource_filter::IndexedRulesetMatcher matcher{base::span(*rules_)};
+  if (matcher.ShouldDisableFilteringForDocument(
+          request.url, first_party.origin(),
+          url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT)) {
+    return false;
+  }
+  const bool disable_generic = matcher.ShouldDisableFilteringForDocument(
+      request.url, first_party.origin(),
+      url_pattern_index::proto::ACTIVATION_TYPE_GENERICBLOCK);
+  const bool disallowed = matcher.GetLoadPolicyForResourceLoad(
+      request.url, first_party, ElementType(request.destination), disable_generic, nullptr) ==
+      subresource_filter::LoadPolicy::DISALLOW;
+  if (disallowed && on_disallowed) {
+    // Native retains the dealer lock through the synchronous cancellation.
+    std::move(on_disallowed).Run();
+  }
+  return disallowed;
+}
