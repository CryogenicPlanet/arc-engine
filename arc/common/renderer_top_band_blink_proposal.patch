+// Copyright 2026 ArcMod. Native source: browser analyzer0x40c05c0.
+#include "cc/paint/arc_top_band_color_analyzer.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+#include "base/numerics/safe_conversions.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+
+namespace cc {
+namespace {
+float ColorDistance(SkColor a, SkColor b) {
+  const float blue = (static_cast<int>(SkColorGetB(a)) -
+                      static_cast<int>(SkColorGetB(b))) / 255.0f;
+  const float red = (static_cast<int>(SkColorGetR(a)) -
+                     static_cast<int>(SkColorGetR(b))) / 255.0f;
+  const float green = (static_cast<int>(SkColorGetG(a)) -
+                       static_cast<int>(SkColorGetG(b))) / 255.0f;
+  // Preserve native difference/divide/square/add/sqrt order. Alpha does not
+  // participate in either the threshold or the exact-zero shortcut.
+  return std::sqrt(blue * blue + (red * red + green * green));
+}
+}  // namespace
+std::optional<SkColor> AnalyzeArcTopBandColor(const SkBitmap& bitmap,
+                                            int sample_height,
+                                            int horizontal_margin) {
+  if (bitmap.width() < 1 || bitmap.height() < 1) {
+    return std::nullopt;
+  }
+  const int second_y = std::clamp(sample_height, 1, bitmap.height()) - 1;
+  const int span = std::max(bitmap.width() - horizontal_margin, 0);
+  std::array<SkColor, 5> top;
+  std::array<SkColor, 5> second;
+  for (size_t i = 0; i < top.size(); ++i) {
+    const float point = (static_cast<float>(i) / 4.0f) * static_cast<float>(span);
+    const int x = std::clamp(base::saturated_cast<int>(point), 0, bitmap.width() - 1);
+    top[i] = bitmap.getColor(x, 0);
+    second[i] = bitmap.getColor(x, second_y);
+  }
+  float maximum = 0;
+  for (size_t i = 1; i < top.size(); ++i) {
+    for (size_t j = 0; j < i; ++j) {
+      maximum = std::max(maximum, ColorDistance(top[j], top[i]));
+    }
+  }
+  maximum = std::max(maximum, ColorDistance(top.front(), second.front()));
+  maximum = std::max(maximum, ColorDistance(top.back(), second.back()));
+  if (maximum == 0) {
+    return top.front();
+  }
+  if (maximum > 0.5f) {
+    return std::nullopt;
+  }
+  float alpha = 0, red = 0, green = 0, blue = 0;
+  for (SkColor color : top) {
+    alpha += SkColorGetA(color);
+    red += SkColorGetR(color);
+    green += SkColorGetG(color);
+    blue += SkColorGetB(color);
+  }
+  const auto mean = [](float sum) {
+    return base::saturated_cast<uint8_t>(std::round(sum / 5.0f));
+  };
+  return SkColorSetARGB(mean(alpha), mean(red), mean(green), mean(blue));
+}
