+// Copyright 2026 ArcMod. Arc's runtime31-to-Blink startup relay.
+#import "arc/api/arc_internal.h"
+
+#include "arc/common/renderer_startup_browser.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/arcmod/arcmod_hooks.h"
+
+namespace arc {
+void AppendRendererStartupCommandLine(base::CommandLine* command_line) {
+  if (!command_line ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app") ||
+      command_line->GetSwitchValueASCII("type") != "renderer" ||
+      !ArcRuntimeFeatureEnabled(31)) {
+    return;
+  }
+  // Native 0x42abd38 uses AppendSwitchNative, not a feature-list merge. On
+  // POSIX this overwrites the map value and appends another argv occurrence.
+  command_line->AppendSwitchASCII("enable-blink-features", "TopBandColorSampling");
+}
+
+void InstallRendererStartupCommandLineHook() {
+  arcmod::GetRendererStartupCommandLineHook() =
+      base::BindRepeating(&AppendRendererStartupCommandLine);
+}
+}  // namespace arc
