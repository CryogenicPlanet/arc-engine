+namespace {
+bool g_arc_skip_pip_user_activation = false;
+bool g_arc_ignore_disable_pip_attribute = true;
+bool IsArcHostRenderer() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app");
+}
+}  // namespace
+
+void SetArcSkipUserActivationForPictureInPicture(bool enabled) {
+  if (IsArcHostRenderer()) g_arc_skip_pip_user_activation = enabled;
+}
+bool ArcSkipUserActivationForPictureInPicture() {
+  return IsArcHostRenderer() && g_arc_skip_pip_user_activation;
+}
+void SetArcIgnoreDisablePictureInPictureAttribute(bool enabled) {
+  if (IsArcHostRenderer()) g_arc_ignore_disable_pip_attribute = enabled;
+}
+bool ArcIgnoreDisablePictureInPictureAttribute() {
+  return IsArcHostRenderer() && g_arc_ignore_disable_pip_attribute;
+}
+
