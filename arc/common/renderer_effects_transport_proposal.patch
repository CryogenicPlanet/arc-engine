+EffectColorScheme CheckedEffectColorScheme(int64_t value) {
+  // Native backends compare w19/w20: only the low 32 bits participate.
+  switch (static_cast<uint32_t>(value)) {
+    case 0: return EffectColorScheme::kLight;
+    case 1: return EffectColorScheme::kDark;
+    default: base::ImmediateCrash();
+  }
+}
 
