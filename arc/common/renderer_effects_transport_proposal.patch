+  // it can reenter and destroy/navigate this WebContents.
+  const HSLAMatrix value = matrix ? matrix.hslaMatrix : HSLAMatrix{};
+  auto* bridge = arc::RendererBridge::For([self webContents]);
+  auto* agent = bridge ? bridge->Agent() : nullptr;
