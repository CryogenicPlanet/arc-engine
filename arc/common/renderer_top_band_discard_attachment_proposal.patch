+void RendererWebContentsRebound(ArcWebContents* wrapper,
+                               content::WebContents* old_contents,
+                               content::WebContents* new_contents) {
+  // Core must establish the global retirement/activation phases and reconcile
+  // target ownership before invoking this synchronous UI-only handoff.
+  if (!wrapper || !new_contents || old_contents == new_contents ||
+      [wrapper webContents] != new_contents) {
+    return;
+  }
+  auto* old_bridge = old_contents ? RendererBridge::FromWebContents(old_contents) : nullptr;
+  // Native discard retains Arc's Impl counter across the Chromium WC swap.
+  const int count = old_bridge ? old_bridge->blocked_resource_count() : 0;
+  // Preserve only CURRENT delivery metadata. This performs no public setter,
+  // replay, refresh, sample, or document-state migration.
+  RebindRendererTopBandColorDelegate(old_contents, new_contents);
+  if (old_contents) {
+    old_contents->RemoveUserData(RendererBridge::UserDataKey());
+  }
+  // Target prior-owner reconciliation is a core precondition. Seed the retained
+  // backend count before constructor frame/configuration publication.
+  new_contents->RemoveUserData(RendererBridge::UserDataKey());
+  RendererBridge::For(new_contents, count);
+  // The public mirror is synchronized last; KVO can destroy native state.
+  if (wrapper.blockedResourceCount != count) {
+    wrapper.blockedResourceCount = count;
+  }
+}
