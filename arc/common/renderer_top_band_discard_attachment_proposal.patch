+void RebindRendererTopBandColorDelegate(content::WebContents* old_contents,
+                                        content::WebContents* new_contents) {
+  if (!new_contents || old_contents == new_contents) {
+    return;
+  }
+  auto* old_metadata = old_contents ? TopBandDelegate::FromWebContents(old_contents) : nullptr;
+  // A strong local bridges the transfer; an already-started Deliver has its
+  // own strong locals. Never consult the wrapper association: nil unregister
+  // deliberately retains an older payload there while clearing this weak slot.
+  RendererTopBandDelegatePayload* current = old_metadata ? old_metadata->Current() : nil;
+  if (old_metadata) {
+    old_metadata->Set(nil);
+  }
+  TopBandDelegate::CreateForWebContents(new_contents);
+  // Nil is authoritative too, including an absent/expired old weak payload.
+  TopBandDelegate::FromWebContents(new_contents)->Set(current);
+}
