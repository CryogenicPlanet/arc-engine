+      : ColorFilter(Type::kCompose, std::move(composed)),
+        outer_(std::move(outer)), inner_(std::move(inner)) {}
+
+ private:
+  size_t SerializedDataSize() const override {
+    base::CheckedNumeric<size_t> size =
+        PaintOpWriter::SerializedSize(outer_.get());
+    size += PaintOpWriter::SerializedSize(inner_.get());
+    return size.ValueOrDie();
+  }
