+  size_t SerializedDataSize() const override {
+    return PaintOpWriter::SerializedSizeOfElements(matrix_.data(), matrix_.size());
+  }
+  void SerializeData(PaintOpWriter& writer) const override {
+    // HSLA filters cannot be recovered with asAColorMatrix (RGBA only).
+    for (float value : matrix_) {
+      writer.Write(value);
+    }
+  }
+  std::array<float, 20> matrix_;
+};
