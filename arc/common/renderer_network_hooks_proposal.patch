+TEST_F(URLRequestMojomTraitsTest, Roundtrips_TopFrameOrigin) {
+  const std::optional<url::Origin> origins[] = {
+      std::nullopt, url::Origin::Create(GURL("https://top.test/")), url::Origin()};
+  for (const auto& origin : origins) {
+    ResourceRequest original;
+    original.top_frame_origin = origin;
+    ResourceRequest copy(original);
+    EXPECT_TRUE(original.EqualsForTesting(copy));
+    EXPECT_EQ(origin, copy.top_frame_origin);
+    ResourceRequest assigned;
+    assigned = original;
+    EXPECT_EQ(origin, assigned.top_frame_origin);
+    ResourceRequest moved(std::move(copy));
+    EXPECT_EQ(origin, moved.top_frame_origin);
+    ResourceRequest decoded;
+    ASSERT_TRUE(mojo::test::SerializeAndDeserialize<mojom::URLRequest>(
+        original, decoded));
+    EXPECT_EQ(origin, decoded.top_frame_origin);
+    EXPECT_TRUE(original.EqualsForTesting(decoded));
+    decoded.top_frame_origin = origin ? std::nullopt
+                                     : std::make_optional(url::Origin());
+    EXPECT_FALSE(original.EqualsForTesting(decoded));
+  }
+}
