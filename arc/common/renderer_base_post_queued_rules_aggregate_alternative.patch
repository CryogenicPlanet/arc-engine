+TopBandColorTracker::TopBandColorTracker(LocalFrame* frame)
+    : frame_(frame), timer_(frame->GetTaskRunner(blink::TaskType::kInternalDefault),
+                            this, &TopBandColorTracker::ScheduleDetection) {}
+
+void TopBandColorTracker::Trace(blink::Visitor* visitor) const {
+  visitor->Trace(frame_);
+  visitor->Trace(cached_style_);
+  timer_.Trace(visitor);
+}
+
+void TopBandColorTracker::FireDetection() {
+  const bool timer_active = timer_.IsActive();
+  if (timer_active) {
+    retry_ = true;
+    if (!pending_ || mode_ == 3) {
+      return;
+    }
+  } else {
+    timer_.StartOneShot(base::Milliseconds(100), FROM_HERE);
+    retry_ = false;
+    if (mode_ == 3) {
+      return;
+    }
+  }
+  auto* view = frame_->View();
+  if (view && view->GetScrollableArea()) {
+    Detect(*view);
+  } else if (view) {
+    mode_ = 3;
+    Submit({});
+  }
+}
+
+void TopBandColorTracker::ScheduleDetection(blink::TimerBase*) {
+  if (retry_ && frame_->View()) {
+    frame_->View()->ScheduleAnimation();
+  }
+}
+
+void TopBandColorTracker::OnLargestContentfulPaintUpdated() {
+  lcp_seen_ = true;
+  cached_node_ = 0;
+  cached_style_ = nullptr;
+  cached_time_ = base::TimeTicks();
+  cached_analyzed_color_.reset();
+  if (frame_->View()) {
+    frame_->View()->ScheduleAnimation();
+  }
+}
+
+void TopBandColorTracker::OnParsingAndFirstPaintReady() {
+  if (!parsing_and_first_paint_ready_) {
+    parsing_and_first_paint_ready_ = true;
+    if (frame_->View()) {
+      frame_->View()->ScheduleAnimation();
+    }
+  }
+}
+
+void TopBandColorTracker::CancelPending() {
+  pending_.reset();
+  ++generation_;
+}
+
+void TopBandColorTracker::Submit(ChosenState state) {
+  if (pending_ && *pending_ == state) {
+    return;
+  }
+  if (pending_) {
+    CancelPending();
+  }
+  if (last_emitted_ && *last_emitted_ == state) {
+    return;
+  }
+  if ((state.request_surface_sample || state.wait_for_presentation) && frame_->GetPage()) {
+    pending_ = std::move(state);
+    const uint64_t generation = ++generation_;
+    frame_->GetPage()->GetChromeClient().NotifyPresentationTime(
+        *frame_, blink::BindOnce(&TopBandColorTracker::DidPresent,
+                                 blink::WrapWeakPersistent(this), generation));
+    return;
+  }
+  Emit(std::move(state));
+}
+
+void TopBandColorTracker::DidPresent(uint64_t generation,
+                                    const viz::FrameTimingDetails&) {
+  if (generation_ != generation || !pending_) {
+    return;
+  }
+  ChosenState state = std::move(*pending_);
+  pending_.reset();
+  Emit(std::move(state));
+}
+
+void TopBandColorTracker::Emit(ChosenState state) {
+  if (last_emitted_ && *last_emitted_ == state) {
+    return;
+  }
+  last_emitted_ = state;
+  bool crossfade = false;
+  if (lcp_seen_) {
+    crossfade = mode_ != 3 && emitted_after_lcp_;
+    emitted_after_lcp_ = true;
+  }
+  if (frame_->Client()) {
+    frame_->Client()->OnArcTopBandColorChanged(
+        state.color ? std::make_optional(state.color->Rgb()) : std::nullopt,
+        state.request_surface_sample, state.token, state.reuse_cached_color,
+        crossfade);
+  }
+}
+
+bool TopBandColorTracker::CompatibleCandidate(Element& element) const {
+  if (cached_node_ != DOMNodeIds::IdForNode(&element) ||
+      base::TimeTicks::Now() - cached_time_ > base::Milliseconds(1500)) {
+    return false;
+  }
+  if (blink::IsA<HTMLImageElement>(element)) {
+    return true;
+  }
+  const auto* style = element.GetComputedStyle();
+  return style == cached_style_ ||
+         (style && cached_style_ &&
+          style->BackgroundLayers() == cached_style_->BackgroundLayers() &&
+          style->Filter() == cached_style_->Filter() &&
+          style->BackdropFilter() == cached_style_->BackdropFilter() &&
+          style->Opacity() == cached_style_->Opacity());
+}
+
+void TopBandColorTracker::RememberAnalyzed(Element& element, Color color) {
+  cached_node_ = DOMNodeIds::IdForNode(&element);
+  cached_style_ = element.GetComputedStyle();
+  cached_time_ = base::TimeTicks::Now();
+  cached_analyzed_color_ = color;
+}
+
+uint64_t TopBandColorTracker::CaptureToken(Element& element) {
+  if (sampling_token_ && CompatibleCandidate(element)) {
+    return sampling_token_;
+  }
+  cached_analyzed_color_.reset();
+  cached_node_ = DOMNodeIds::IdForNode(&element);
+  cached_style_ = element.GetComputedStyle();
+  cached_time_ = base::TimeTicks::Now();
+  return ++sampling_token_;
+}
+
+bool TopBandColorTracker::SignificantImage(const Element& element) const {
+  if (blink::IsA<HTMLImageElement>(element)) {
+    return true;
+  }
+  const auto& style = *element.GetComputedStyle();
+  for (auto* layer = &style.BackgroundLayers(); layer; layer = layer->Next()) {
+    auto* image = layer->GetImage();
+    if (!image || (!image->IsImageResource() && !image->IsGeneratedImage())) {
+      continue;
+    }
+    if (layer->Repeat().y == blink::EFillRepeat::kNoRepeatFill) {
+      if (layer->BackgroundYOrigin() == blink::BackgroundEdgeOrigin::kBottom ||
+          (layer->BackgroundYOrigin() == blink::BackgroundEdgeOrigin::kTop &&
+           layer->PositionY().IsPercent() && layer->PositionY().Percent() == 100)) {
+        continue;
+      }
+      return true;
+    }
+    if (image->IsImageResource() &&
+        layer->Repeat().x == blink::EFillRepeat::kNoRepeatFill) {
+      auto* box = blink::DynamicTo<blink::LayoutBox>(element.GetLayoutObject());
+      auto* resource = image->CachedImage();
+      if (box && resource && frame_->GetPage()) {
+        const float ratio = frame_->GetPage()->InspectorDeviceScaleFactorOverride() *
+                            frame_->LayoutZoomFactor();
+        if (resource->IntrinsicSize(blink::kRespectImageOrientation).width() * ratio <
+            box->PhysicalContentBoxRect().Width().ToFloat() * 0.5f) {
+          continue;
+        }
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+std::optional<Color> TopBandColorTracker::AnalyzeImage(Element& element) const {
+  auto analyze_resource = [](blink::ImageResourceContent* resource) -> std::optional<Color> {
+    if (!resource || resource->GetContentStatus() <= blink::ResourceStatus::kPending) {
+      return std::nullopt;
+    }
+    auto* image = resource->GetImage();
+    if (!image) {
+      return std::nullopt;
+    }
+    auto color = cc::AnalyzeArcTopBandColor(
+        image->AsSkBitmapForCurrentFrame(blink::kRespectImageOrientation), 8, 24);
+    return color ? std::make_optional(Color::FromSkColor(*color)) : std::nullopt;
+  };
+  if (auto* image = blink::DynamicTo<HTMLImageElement>(element)) {
+    return analyze_resource(image->CachedImage());
+  }
+  const auto& style = *element.GetComputedStyle();
+  for (auto* layer = &style.BackgroundLayers(); layer; layer = layer->Next()) {
+    auto* style_image = layer->GetImage();
+    if (!style_image || (!style_image->IsImageResource() && !style_image->IsGeneratedImage())) {
+      continue;
+    }
+    std::optional<Color> color;
+    if (style_image->IsImageResource()) {
+      color = analyze_resource(style_image->CachedImage());
+    } else {
+      const auto bounds = element.GetLayoutObject()->AbsoluteBoundingBoxRect();
+      const int width = std::min(bounds.width(), 800);
+      const int height = std::min(bounds.height(), 800);
+      if (width > 0 && height > 0) {
+        SkBitmap bitmap;
+        if (bitmap.tryAllocPixels(SkImageInfo::Make(width, height,
+                                                    kBGRA_8888_SkColorType,
+                                                    kPremul_SkAlphaType))) {
+          bitmap.eraseColor(SK_ColorTRANSPARENT);
+          gfx::SizeF size(width, height);
+          auto image = style_image->GetImage(*element.GetLayoutObject(), element, style, size);
+          if (image) {
+            cc::SkiaPaintCanvas canvas(bitmap);
+            cc::PaintFlags flags;
+            blink::ImageDrawOptions options;
+            image->Draw(&canvas, flags, gfx::RectF(size), gfx::RectF(size), options);
+            auto analyzed = cc::AnalyzeArcTopBandColor(bitmap, 8, 24);
+            if (analyzed) {
+              color = Color::FromSkColor(*analyzed);
+            }
+          }
+        }
+      }
+    }
+    if (color) {
+      // A translucent result stops layer traversal and enters capture admission.
+      return color;
+    }
+  }
+  return std::nullopt;
+}
+
+namespace {
+bool VisibleForTopBand(const Element& element) {
+  const auto* style = element.GetComputedStyle();
+  return style && element.GetLayoutObject() &&
+         style->Visibility() == blink::EVisibility::kVisible &&
+         style->Display() != blink::EDisplay::kNone && style->Opacity() > 0;
+}
+Element* EligibleTopBandElement(blink::Node* node, int width, bool coalesced) {
+  auto* element = blink::DynamicTo<Element>(node);
+  if (!element || !VisibleForTopBand(*element)) {
+    return nullptr;
+  }
+  const auto bounds = element->GetLayoutObject()->AbsoluteBoundingBoxRect();
+  if (bounds.height() < 11 || bounds.width() < width / 3) {
+    return nullptr;
+  }
+  // Native B.LT reaches the preserve-pointer return, while the feature-false
+  // CBZ reaches the zero-pointer return. Edge candidates bypass quarter tests.
+  if (bounds.x() < 1 || bounds.right() >= width) {
+    return element;
+  }
+  if (!coalesced) {
+    return nullptr;
+  }
+  for (int i = 1; i < 4; ++i) {
+    const int x = i * (width / 4);
+    if (x < bounds.x() || x >= bounds.right()) {
+      return nullptr;
+    }
+  }
+  return element;
+}
+bool IsCanvasOrVideo(const Element& element) {
+  return blink::IsA<blink::HTMLCanvasElement>(element) ||
+         blink::IsA<blink::HTMLVideoElement>(element);
+}
+bool AllowsSurfaceCapture(const blink::HitTestResult::NodeSet& nodes, int width) {
+  for (blink::Node* hit : nodes) {
+    for (auto* node = hit; node; node = node->ParentOrShadowHostElement()) {
+      auto* element = blink::DynamicTo<Element>(node);
+      if (element && IsCanvasOrVideo(*element) && VisibleForTopBand(*element)) {
+        const auto bounds = element->GetLayoutObject()->AbsoluteBoundingBoxRect();
+        if (bounds.width() >= width / 3 && bounds.height() >= 11) {
+          return false;
+        }
+      }
+    }
+  }
+  return true;
+}
+bool UseRawTopBandPoints(const blink::HitTestResult::NodeSet& nodes,
+                         blink::LayoutView& layout, int width, bool coalesced) {
+  Element* first = nullptr;
+  for (blink::Node* node : nodes) {
+    if ((first = EligibleTopBandElement(node, width, coalesced))) {
+      break;
+    }
+  }
+  for (auto* object = first ? first->GetLayoutObject() : nullptr;
+       object && object != &layout; object = object->ContainingBlock()) {
+    if (object->StyleRef().GetPosition() == blink::EPosition::kFixed) {
+      return true;
+    }
+    auto* box = blink::DynamicTo<blink::LayoutBoxModelObject>(object);
+    if (box && box->StickyPositionOffset() != blink::PhysicalOffset()) {
+      return true;
+    }
+  }
+  return false;
+}
