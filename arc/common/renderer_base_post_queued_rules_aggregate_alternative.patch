+class ArcColorFilterCodecTest : public testing::TestWithParam<bool> {};
+INSTANTIATE_TEST_SUITE_P(SecurityModes, ArcColorFilterCodecTest,
+                         testing::Bool());
+
+// Exposes the type tag for malformed-wire tests without hardcoding its number.
+class ArcColorFilterWireTypes final : public ColorFilter {
+ public:
+  static constexpr uint8_t kComposeTag = static_cast<uint8_t>(Type::kCompose);
+};
+
+}  // namespace
+
+TEST_P(ArcColorFilterCodecTest, HSLARoundTripMatchesSkiaRatherThanRGBAMatrix) {
+  auto original = ColorFilter::MakeHSLAMatrix(kArcTestHSLAMatrix.data());
+  auto encoded = EncodeArcColorFilter(original, GetParam());
+  bool valid = false;
+  auto decoded = DecodeArcColorFilter(
+      encoded.memory.as_span().first(encoded.size), GetParam(), &valid);
+  ASSERT_TRUE(valid);
+  ASSERT_TRUE(decoded);
+  auto expected = SkColorFilters::HSLAMatrix(kArcTestHSLAMatrix.data());
+  auto rgba = SkColorFilters::Matrix(kArcTestHSLAMatrix.data());
+  ASSERT_TRUE(expected);
+  ASSERT_TRUE(rgba);
+  bool differs_from_rgba = false;
+  for (const auto& input : kArcTestColors) {
+    auto reference = expected->filterColor4f(input, nullptr, nullptr);
+    ExpectArcColorNear(original->FilterColor(input), reference);
+    ExpectArcColorNear(decoded->FilterColor(input), reference);
+    auto rgba_color = rgba->filterColor4f(input, nullptr, nullptr);
+    differs_from_rgba |= std::abs(reference.fR - rgba_color.fR) > 1e-3f ||
+                         std::abs(reference.fG - rgba_color.fG) > 1e-3f ||
+                         std::abs(reference.fB - rgba_color.fB) > 1e-3f;
+  }
+  EXPECT_TRUE(differs_from_rgba);
+}
+
+TEST_P(ArcColorFilterCodecTest, ComposeRoundTripPreservesTableAndInnerFilterOrder) {
+  std::array<uint8_t, 256> alpha, rgb;
+  for (size_t i = 0; i < alpha.size(); ++i) {
+    alpha[i] = static_cast<uint8_t>(i);
+    rgb[i] = static_cast<uint8_t>(std::min(i, size_t{254}));
+  }
+  auto hsla = ColorFilter::MakeHSLAMatrix(kArcTestHSLAMatrix.data());
+  auto table = ColorFilter::MakeTableARGB(alpha.data(), rgb.data(), rgb.data(),
+                                          rgb.data());
+  auto inner = ColorFilter::MakeBlend({0.7f, 0.2f, 0.1f, 0.4f},
+                                       SkBlendMode::kSrcOver);
+  auto arc_filter = ColorFilter::MakeCompose(hsla, table);
+  auto original = ColorFilter::MakeCompose(arc_filter, inner);
+  auto encoded = EncodeArcColorFilter(original, GetParam());
+  bool valid = false;
+  auto decoded = DecodeArcColorFilter(
+      encoded.memory.as_span().first(encoded.size), GetParam(), &valid);
+  ASSERT_TRUE(valid);
+  ASSERT_TRUE(decoded);
+  auto sk_hsla = SkColorFilters::HSLAMatrix(kArcTestHSLAMatrix.data());
+  auto sk_table = SkColorFilters::TableARGB(alpha.data(), rgb.data(), rgb.data(),
+                                            rgb.data());
+  auto sk_inner = SkColorFilters::Blend(SkColor4f{0.7f, 0.2f, 0.1f, 0.4f},
+                                         nullptr, SkBlendMode::kSrcOver);
+  auto expected = SkColorFilters::Compose(
+      SkColorFilters::Compose(sk_hsla, sk_table), sk_inner);
+  auto reversed = SkColorFilters::Compose(
+      sk_inner, SkColorFilters::Compose(sk_table, sk_hsla));
+  ASSERT_TRUE(expected);
+  ASSERT_TRUE(reversed);
+  bool differs_when_reversed = false;
+  for (const auto& input : kArcTestColors) {
+    auto reference = expected->filterColor4f(input, nullptr, nullptr);
+    ExpectArcColorNear(original->FilterColor(input), reference);
+    ExpectArcColorNear(decoded->FilterColor(input), reference);
+    auto reverse_color = reversed->filterColor4f(input, nullptr, nullptr);
+    differs_when_reversed |= std::abs(reference.fR - reverse_color.fR) > 1e-3f ||
+                             std::abs(reference.fG - reverse_color.fG) > 1e-3f ||
+                             std::abs(reference.fB - reverse_color.fB) > 1e-3f;
+  }
+  EXPECT_TRUE(differs_when_reversed);
+}
+
+TEST_P(ArcColorFilterCodecTest, NullIsIdentityAndSurvivesRoundTrip) {
+  auto filter = ColorFilter::MakeHSLAMatrix(kArcTestHSLAMatrix.data());
+  EXPECT_EQ(ColorFilter::MakeCompose(filter, nullptr).get(), filter.get());
+  EXPECT_EQ(ColorFilter::MakeCompose(nullptr, filter).get(), filter.get());
+  EXPECT_FALSE(ColorFilter::MakeCompose(nullptr, nullptr));
+  auto encoded = EncodeArcColorFilter(nullptr, GetParam());
+  bool valid = false;
+  auto decoded = DecodeArcColorFilter(
+      encoded.memory.as_span().first(encoded.size), GetParam(), &valid);
+  EXPECT_TRUE(valid);
+  EXPECT_FALSE(decoded);
+}
+
+TEST_P(ArcColorFilterCodecTest, RejectsEveryTruncatedHSLAAndComposePayload) {
+  auto hsla = ColorFilter::MakeHSLAMatrix(kArcTestHSLAMatrix.data());
+  const std::array<sk_sp<ColorFilter>, 2> filters = {
+      hsla, ColorFilter::MakeCompose(hsla, ColorFilter::MakeLuma())};
+  for (const auto& filter : filters) {
+    auto encoded = EncodeArcColorFilter(filter, GetParam());
+    for (size_t length = 0; length < encoded.size; ++length) {
+      SCOPED_TRACE(length);
+      bool valid = true;
+      auto decoded = DecodeArcColorFilter(
+          encoded.memory.as_span().first(length), GetParam(), &valid);
+      EXPECT_FALSE(valid);
+      EXPECT_FALSE(decoded);
+    }
+  }
+}
+
+TEST_P(ArcColorFilterCodecTest, RejectsUnknownTypeInsideCompose) {
+  auto memory = PaintOpWriter::AllocateAlignedBuffer(64);
+  TestOptionsProvider options;
+  PaintOpWriter writer(memory.as_span(), options.serialize_options(), GetParam());
+  writer.Write(static_cast<uint8_t>(PaintFilter::Type::kColorFilter));
+  writer.Write(uint32_t{0});  // No crop rect.
+  writer.Write(ArcColorFilterWireTypes::kComposeTag);
+  writer.Write(uint8_t{255});  // Unknown outer color-filter type.
+  writer.Write(uint8_t{0});    // Null inner color filter.
+  writer.Write(static_cast<uint8_t>(PaintFilter::Type::kNullFilter));
+  ASSERT_GT(writer.size(), 0u);
+  base::HistogramTester histograms;
+  bool valid = true;
+  auto decoded = DecodeArcColorFilter(memory.as_span().first(writer.size()),
+                                      GetParam(), &valid);
+  EXPECT_FALSE(valid);
+  EXPECT_FALSE(decoded);
+  histograms.ExpectBucketCount("GPU.PaintOpReader.DeserializationError", 1, 1);
+}
+
+TEST_P(ArcColorFilterCodecTest, AcceptsDepth64AndRejectsDepth65) {
+  auto leaf = ColorFilter::MakeLuma();
+  auto chain = leaf;
+  for (unsigned depth = 1; depth <= 65; ++depth) {
+    if (depth > 1) {
+      chain = ColorFilter::MakeCompose(leaf, chain);
+    }
+    if (depth != 64 && depth != 65) {
+      continue;
+    }
+    SCOPED_TRACE(depth);
+    auto encoded = EncodeArcColorFilter(chain, GetParam());
+    base::HistogramTester histograms;
+    bool valid = false;
+    auto decoded = DecodeArcColorFilter(
+        encoded.memory.as_span().first(encoded.size), GetParam(), &valid);
+    EXPECT_EQ(valid, depth == 64);
+    EXPECT_EQ(static_cast<bool>(decoded), depth == 64);
+    histograms.ExpectBucketCount("GPU.PaintOpReader.DeserializationError", 59,
+                                  depth == 65 ? 1 : 0);
+  }
+}
 
