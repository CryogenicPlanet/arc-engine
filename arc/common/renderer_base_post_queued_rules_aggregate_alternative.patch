+void TopBandColorTracker::Detect(LocalFrameView& view) {
+  auto* document = frame_->GetDocument();
+  auto* layout = document ? document->GetLayoutView() : nullptr;
+  auto* area = layout ? layout->GetScrollableArea() : nullptr;
+  if (!document || !layout) {
+    mode_ = 3;
+    Submit({});
+    return;
+  }
+  const int width = area ? area->VisibleContentRect(blink::kExcludeScrollbars).width() : 0;
+  if (width <= 0) {
+    // A transient nonpositive width does not latch the terminal mode or emit.
+    // Native cancels only an active background-presentation wait here.
+    if (pending_ && pending_->wait_for_presentation) {
+      CancelPending();
+    }
+    return;
+  }
+  const bool coalesced = base::FeatureList::IsEnabled(
+      blink::features::kArcMacCoalescedResizing);
+  if (coalesced) {
+    bool active_transition = false;
+    blink::ViewTransitionUtils::ForEachTransition(*document,
+        [&](blink::ViewTransition& transition) {
+          active_transition |= !transition.IsDone();
+        });
+    if (active_transition) {
+      retry_ = true;
+      return;
+    }
+  }
+  Color root_background = Color::kTransparent;
+  const auto& root_style = layout->StyleRef();
+  if (root_style.HasBackground()) {
+    const auto color = root_style.VisitedDependentColor(
+        blink::GetCSSPropertyBackgroundColor());
+    if (color.IsOpaque()) {
+      root_background = color;
+    }
+  }
+  const bool scrolled = view.GetScrollableArea()->GetScrollOffset().y() > 0;
+  constexpr unsigned flags = blink::HitTestRequest::kReadOnly |
+      blink::HitTestRequest::kActive | blink::HitTestRequest::kIgnoreClipping |
+      blink::HitTestRequest::kIgnorePointerEventsNone |
+      blink::HitTestRequest::kListBased | blink::HitTestRequest::kPenetratingList;
+  static_assert(flags == 0x1c26);
+  struct Vote {
+    ChosenState state;
+    int count = 0;
+  };
+  blink::HeapHashMap<blink::Member<Element>, Vote> votes;
+  auto vote = [&](Element* element, ChosenState state) {
+    auto& entry = votes.insert(element, Vote{}).stored_value->value;
+    entry.state = std::move(state);
+    ++entry.count;
+  };
