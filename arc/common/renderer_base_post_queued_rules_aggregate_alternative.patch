+ private:
+  friend class base::RefCountedThreadSafe<NetworkRulesBroker>;
+  ~NetworkRulesBroker();
+  mutable base::Lock lock_;
+  scoped_refptr<const base::RefCountedMemory> rules_ GUARDED_BY(lock_);
+  scoped_refptr<const NetworkExclusions> exclusions_ GUARDED_BY(lock_);
+  uint64_t exclusions_revision_ GUARDED_BY(lock_) = 0;
+  bool has_exclusions_ GUARDED_BY(lock_) = false;
+};
