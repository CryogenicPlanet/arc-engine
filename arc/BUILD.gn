# Copyright 2026 ArcMod.
# ArcCore: Arc's engine interface implemented on Chromium. Linked into the Mac framework
# (//chrome:chrome_dll) by patches/0002-arccore-framework-layout.patch; the framework is named ArcCore.

source_set("arc_core") {
  sources = [
    "api/arc_api_stubs.mm",
    "api/arc_browser_application.mm",
    "api/arc_exports.mm",
  ]
  inputs = [
    "api/arc_api_classes.inc",
    "api/arc_api_table.inc",
  ]
  frameworks = [
    "AppKit.framework",
    "Foundation.framework",
  ]
  deps = [
    "//base",
    "//components/version_info",
  ]

  # Calls the hosted entry points in //chrome:chrome_dll (chrome/app/chrome_main.h), which links this
  # target into the same framework; a gn dep back to it would be a cycle.
  check_includes = false
}
