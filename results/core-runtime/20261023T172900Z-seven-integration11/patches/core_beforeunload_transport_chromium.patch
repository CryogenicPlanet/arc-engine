--- a/chrome/browser/arcmod/arcmod_hooks.h
+++ b/chrome/browser/arcmod/arcmod_hooks.h
@@ -54,6 +54,23 @@
     content::WebContents* source, base::OnceClosure continue_close)>;
 inline NativeCloseContentsHook& GetNativeCloseContentsHook() {
   static base::NoDestructor<NativeCloseContentsHook> hook;
+  return *hook;
+}
+
+// Synchronous pre-forward notification. A consumer may invoke app code, then
+// choose whether the ORIGINAL BeforeUnload forwarding operation still applies.
+// Skip leaves the caller's borrowed output bool UNCHANGED. The output pointer
+// is never exposed to the hook; no delayed response/continuation is supported.
+// Consumers must validate logical association after their own app callouts.
+enum class NativeBeforeUnloadDisposition {
+  kContinueOriginal,
+  kSkipOriginal,
+};
+using NativeBeforeUnloadFiredHook =
+    base::RepeatingCallback<NativeBeforeUnloadDisposition(
+        content::WebContents* source, bool proceed)>;
+inline NativeBeforeUnloadFiredHook& GetNativeBeforeUnloadFiredHook() {
+  static base::NoDestructor<NativeBeforeUnloadFiredHook> hook;
   return *hook;
 }
 
--- a/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
+++ b/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
@@ -898,6 +898,28 @@
     content::WebContents* web_contents,
     bool proceed,
     bool* proceed_to_fire_unload) {
+  if (web_contents && base::CommandLine::ForCurrentProcess()->HasSwitch(
+                          "arcmod-host-app")) {
+    auto hook = arcmod::GetNativeBeforeUnloadFiredHook();
+    if (hook) {
+      // The output belongs to the synchronous caller's stack. Never capture it
+      // into an owning continuation or permit a delayed write to that storage.
+      auto delegate = weak_factory_.GetWeakPtr();
+      auto source = web_contents->GetWeakPtr();
+      const auto disposition = hook.Run(web_contents, proceed);
+      if (disposition !=
+              arcmod::NativeBeforeUnloadDisposition::kContinueOriginal ||
+          !delegate || !source) {
+        return;
+      }
+      // Weak liveness alone does not establish continued membership after a
+      // transfer. A consumer must choose SkipOriginal when its captured logical
+      // association no longer authorizes this original forwarding operation.
+      delegate->unload_controller_->BeforeUnloadFired(
+          source.get(), proceed, proceed_to_fire_unload);
+      return;  // Native forwarding can destroy this delegate or source.
+    }
+  }
   unload_controller_->BeforeUnloadFired(web_contents, proceed,
                                         proceed_to_fire_unload);
 }
