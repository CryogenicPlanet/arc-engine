+// Separate from the primary widget's metadata observation: native ready events
+// can come from any Mac source widget belonging to the wrapped WebContents.
+class WidgetReadyState final : public content::RenderWidgetHostObserver,
+                               public ui::CompositorObserver {
+ public:
+  WidgetReadyState(base::WeakPtr<CoreRenderStateObserver> owner,
+                   content::RenderWidgetHost* widget)
+      : owner_(owner),
+        widget_(content::RenderWidgetHostImpl::From(widget)->GetWeakPtr()) {
+    widget_observation_.Observe(widget);
+  }
+
+  ~WidgetReadyState() override { Reset(); }
+
+  content::RenderWidgetHost* widget() const { return widget_.get(); }
+
+  void FrameReceived() {
+    ObserveSourceCompositor();
+    has_received_frame_ = true;
+    QueueReady(true);
+  }
+
+  void SurfaceCopied() {
+    ObserveSourceCompositor();
+    if (has_received_frame_) {
