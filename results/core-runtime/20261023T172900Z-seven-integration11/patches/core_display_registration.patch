+
+void WidgetReadyState::QueueReady(bool ready) {
+  if (owner_) {
+    owner_->QueueReady(ready);
+  }
+}
+
+CoreRenderStateObserver* FindReadyOwner(content::WebContents* contents) {
+  const auto& registry = ReadyContents();
+  const auto it = registry.find(contents);
+  return it == registry.end() ? nullptr : it->second.get();
+}
+
+void ForwardFrameToken(content::WebContents* contents,
+                       content::RenderWidgetHost* widget) {
+  if (auto* owner = FindReadyOwner(contents)) {
+    if (auto* state = owner->ReadyState(widget)) {
+      state->FrameReceived();
+    }
+  }
+}
+
+void ForwardSurfaceCopy(content::WebContents* contents,
+                        content::RenderWidgetHost* widget) {
+  if (auto* owner = FindReadyOwner(contents)) {
+    if (auto* state = owner->ReadyState(widget)) {
+      state->SurfaceCopied();
+    }
+  }
+}
+
+void ForwardViewUnparented(content::WebContents* contents,
+                           content::RenderWidgetHost* widget) {
+  if (auto* owner = FindReadyOwner(contents)) {
+    if (auto* state = owner->ReadyState(widget)) {
+      state->ViewUnparented();
+    }
+  }
+}
+
+void ForwardOwnCompositor(content::BrowserCompositorMac* browser_compositor,
+                          ui::Compositor* compositor) {
+  auto& registry = ReadyCompositors();
+  const auto it = registry.find(browser_compositor);
+  if (it == registry.end()) {
+    return;
+  }
+  auto state = it->second;
+  if (state) {
+    state->OwnCompositorChanged(browser_compositor, compositor);
+  } else {
+    registry.erase(it);
+  }
+}
