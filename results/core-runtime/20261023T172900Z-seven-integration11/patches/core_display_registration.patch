+    }
+  }
+
+  void ViewUnparented() {
+    ObserveSourceCompositor();
+    // Occlusion does not clear the native has-received-frame flag.
+    QueueReady(false);
+  }
+
+  void OwnCompositorChanged(content::BrowserCompositorMac* browser_compositor,
+                            ui::Compositor* compositor) {
+    if (!browser_compositor_) {
+      // The native destructor invalidates its weak pointers before this final
+      // null notification, even if it already had no compositor.
+      compositor_observation_.Reset();
+      ReadyCompositors().erase(browser_compositor);
+      has_received_frame_ = false;
+      return;
+    }
+    SetCompositor(compositor);
+  }
+
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost*) override {
+    Reset();
+  }
+
+  void OnCompositingAckDeprecated(ui::Compositor*) override {
+    if (has_received_frame_) {
+      QueueReady(true);
+    }
+  }
+
+  void OnCompositingShuttingDown(ui::Compositor*) override {
+    compositor_observation_.Reset();
+  }
+
+ private:
+  void QueueReady(bool ready);
+
+  void ObserveSourceCompositor() {
+    if (!widget_) {
+      return;
+    }
+    // Only native Mac-view hooks enter this path. A replaced child-frame view
+    // must not be treated as the Mac view that supplied an earlier event.
+    auto* base_view = static_cast<content::RenderWidgetHostViewBase*>(
+        widget_->GetView());
+    auto* view = base_view && !base_view->IsRenderWidgetHostViewChildFrame()
+        ? static_cast<content::RenderWidgetHostViewMac*>(base_view) : nullptr;
+    auto* browser_compositor = view ? view->BrowserCompositor() : nullptr;
+    if (browser_compositor == browser_compositor_.get()) {
+      return;
+    }
+    compositor_observation_.Reset();
+    UnregisterCompositor();
+    browser_compositor_.reset();
+    has_received_frame_ = false;
+    if (!browser_compositor) {
+      return;
+    }
+    browser_compositor_ = browser_compositor->GetWeakPtr();
+    ReadyCompositors()[browser_compositor] = weak_factory_.GetWeakPtr();
+    // A parent layer means the view borrows its parent's compositor. The
+    // original ready observer subscribes only to an owned compositor.
+    if (!browser_compositor->GetDelegatedFrameHostLayer()->parent()) {
+      SetCompositor(browser_compositor->GetCompositor());
+    }
+  }
+
+  void SetCompositor(ui::Compositor* compositor) {
+    if (compositor_observation_.IsObservingSource(compositor)) {
+      return;
+    }
+    compositor_observation_.Reset();
+    if (compositor) {
+      // A native own-attach notification precedes Unsuspend and state
+      // assignment; its argument is authoritative during that transition.
+      compositor_observation_.Observe(compositor);
+    }
+  }
+
+  void UnregisterCompositor() {
+    // No raw BrowserCompositor key is retained by the state. Its destructor
+    // notification can arrive after the corresponding weak pointer expires.
+    auto& registry = ReadyCompositors();
+    for (auto it = registry.begin(); it != registry.end();) {
+      if (it->second.get() == this) {
+        it = registry.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+
+  void Reset() {
+    compositor_observation_.Reset();
+    UnregisterCompositor();
+    browser_compositor_.reset();
+    widget_observation_.Reset();
+    widget_.reset();
+  }
+
+  base::WeakPtr<CoreRenderStateObserver> owner_;
+  base::WeakPtr<content::RenderWidgetHostImpl> widget_;
+  base::WeakPtr<content::BrowserCompositorMac> browser_compositor_;
+  bool has_received_frame_ = false;
+  base::ScopedObservation<content::RenderWidgetHost,
+                          content::RenderWidgetHostObserver>
+      widget_observation_{this};
+  base::ScopedObservation<ui::Compositor, ui::CompositorObserver>
+      compositor_observation_{this};
+  base::WeakPtrFactory<WidgetReadyState> weak_factory_{this};
+};
