+namespace content::host_receipt_diagnostics {
+// IDs are local to the linked image containing this inline helper. The emitted
+// counter address distinguishes images; do not assume cross-image ID uniqueness.
+struct Receipt {
+  uint64_t id = 0;
+  uintptr_t counter = 0;
+  uintptr_t native = 0;
+};
+
+inline Receipt Begin(const void* native) {
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("arcmod-host-app") ||
+      !command_line->HasSwitch("arcmod-core-receipt-diagnostics")) {
+    return {};
+  }
+  static std::atomic<uint64_t> next{0};
+  return {next.fetch_add(1, std::memory_order_relaxed) + 1,
+          reinterpret_cast<uintptr_t>(&next),
+          reinterpret_cast<uintptr_t>(native)};
+}
+
+inline void Emit(Receipt receipt, const char* phase,
+                 uintptr_t peer = 0, uintptr_t auxiliary = 0,
+                 double value = 0, bool bit = false) {
+  if (!receipt.id) {
+    return;
+  }
+  LOG(ERROR) << "ARC_CORE_RECEIPT v=1 counter=" << receipt.counter
+            << " id=" << receipt.id << " phase=" << phase
+            << " tid=" << base::PlatformThread::CurrentId()
+            << " us=" << base::TimeTicks::Now().since_origin().InMicroseconds()
+            << " native=" << receipt.native << " peer=" << peer
+            << " aux=" << auxiliary << " value=" << std::setprecision(17)
+            << value << " bit=" << bit;
+}
+
+// This scope carries scalar identities only. It does not dereference the native
+// object on exit, including when an observer destroyed it during dispatch.
+class ProgressSend final {
+ public:
+  explicit ProgressSend(const void* native) : receipt_(Begin(native)) {
+    Emit(receipt_, "progress-send-enter");
+  }
+  ~ProgressSend() { Emit(receipt_, "progress-send-exit"); }
+  double Value(double value) const {
+    Emit(receipt_, "progress-send-value", 0, 0, value);
+    return value;
+  }
+ private:
+  const Receipt receipt_;
+};
+}  // namespace content::host_receipt_diagnostics
+
 #endif  // CONTENT_PUBLIC_BROWSER_HOST_APP_HOOKS_H_
