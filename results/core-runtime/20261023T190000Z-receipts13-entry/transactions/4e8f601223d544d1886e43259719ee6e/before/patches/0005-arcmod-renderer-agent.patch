 void ChromeContentRendererClient::RenderFrameCreated(
     content::RenderFrame* render_frame) {
+  // ArcMod: Arc's per-frame agent (effects, stylesheets, extraction) when Arc's
+  // app hosts the engine. CreateRenderFrameAgent also checks the switch.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app")) {
+    arc::CreateRenderFrameAgent(render_frame);
+  }
   ChromeRenderFrameObserver* render_frame_observer =
       new ChromeRenderFrameObserver(render_frame, web_cache_impl_.get());
   service_manager::BinderRegistry* registry = render_frame_observer->registry();
@@ -1487,6 +1494,10 @@ ChromeContentRendererClient::CreateSpeechRecognitionClient(
 
 void ChromeContentRendererClient::RunScriptsAtDocumentStart(
     content::RenderFrame* render_frame) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app") &&
+      !arc::RunEffectsAtDocumentStart(render_frame)) {
+    return;
+  }
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   extensions::ExtensionsRendererClient::Get()->RunScriptsAtDocumentStart(
       render_frame);
