# Stock Arc's real tabs listener. Native component registration keeps it out of
# the app's user-extension list and toolbar.
bundle_data("resources") {
  visibility = [ "//arc:arc_core" ]
  sources = [
    "background.js",
    "manifest.json",
  ]
  outputs =
      [ "{{bundle_resources_dir}}/arc_internal_extension/{{source_file_part}}" ]
}
