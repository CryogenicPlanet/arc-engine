import os,pathlib,shutil,subprocess,sys,uuid
root=pathlib.Path('/Users/cryogenicplanet/general/arc-engine')
lockpid=int((root/'logs/arccore-build.lock/pid').read_text())
ancestor=os.getpid()
for _ in range(32):
 if ancestor==lockpid:break
 ancestor=int(subprocess.check_output(['/bin/ps','-p',str(ancestor),'-o','ppid=']).strip())
else:raise RuntimeError('shared lock ancestry required')
agents=sys.argv[1].split(',');command=sys.argv[2:]
if not command or agents!=['ours156']:raise RuntimeError('only the single ours156 agent is permitted')
base=pathlib.Path.home()/'Library/Application Support';state=[];nonce=uuid.uuid4().hex
app_prefix=str(root.parent/'arc/build/ArcModAgent-ours156.app')+'/'
def own_app_pids():
 lines=subprocess.check_output(['/bin/ps','-axww','-o','pid=,comm=']).decode().splitlines()
 result=[]
 for line in lines:
  parts=line.strip().split(None,1)
  if len(parts)!=2 or not parts[0].isdigit():raise RuntimeError('cannot parse process identity snapshot')
  if parts[1].startswith(app_prefix):result.append(int(parts[0]))
 return result
if own_app_pids():raise RuntimeError('refusing profile isolation while ours156 main or helper runs')
try:
 for a in agents:
  path=base/('ArcModAgent-'+a);backup=base/('ArcModAgent-'+a+'.sessions-'+nonce+'.backup')
  if path.is_symlink() or backup.exists():raise RuntimeError('unexpected symlink/backup collision')
  existed=path.exists()
  if existed:path.rename(backup)
  path.mkdir(mode=0o700);identity=(path.stat().st_dev,path.stat().st_ino)
  state.append((path,backup,existed,identity))
  print('ISOLATED',path,'backup',backup if existed else 'none',flush=True)
 result=subprocess.run(command)
 code=result.returncode
finally:
 running=own_app_pids()
 if running:
  print('ERROR owned agent main/helper still running; preserving isolated profile and backup:',running,file=sys.stderr)
  for path,backup,_,_ in state:print('PRESERVED',path,backup,file=sys.stderr)
  raise RuntimeError('refused profile restoration while app still runs')
 for path,backup,existed,identity in reversed(state):
  if path.is_symlink() or (path.stat().st_dev,path.stat().st_ino)!=identity:raise RuntimeError('isolated profile identity changed; refused cleanup')
  shutil.rmtree(path)
  if existed:backup.rename(path)
  print('RESTORED',path,flush=True)
raise SystemExit(code)
