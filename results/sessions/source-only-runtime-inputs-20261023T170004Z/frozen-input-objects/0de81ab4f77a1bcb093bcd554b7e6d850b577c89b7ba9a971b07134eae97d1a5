#!/usr/bin/env python3
"""Isolate only the disposable ours156 cache under the caller's shared lock."""
import ctypes
import os
from pathlib import Path
import stat
import subprocess
import sys
import uuid

ROOT = Path('/Users/cryogenicplanet/general/arc-engine')
PARENT = Path('/Users/cryogenicplanet/Library/Caches')
NAME = 'ArcModAgent-ours156'
APP_PREFIX = str(ROOT.parent / 'arc/build/ArcModAgent-ours156.app') + '/'
LOCK_DIR = ROOT / 'logs/arccore-build.lock'
LOCK_PID = LOCK_DIR / 'pid'
RENAME_EXCL = 0x00000004
RENAME_NOFOLLOW_ANY = 0x00000010
RESTORE_ERROR = 74


def identity(st):
    return st.st_dev, st.st_ino


def real_directory(path):
    # Do not resolve symlinks into a different user's/cache/lock tree.
    for part in [*reversed(path.parents), path]:
        info = part.lstat()
        if not stat.S_ISDIR(info.st_mode):
            raise RuntimeError('non-directory or symlink path component: ' + str(part))
    return path.lstat()


def lock_snapshot():
    real_directory(LOCK_DIR)
    info = LOCK_PID.lstat()
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError('shared lock pid is not a regular file')
    fd = os.open(LOCK_PID, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        if identity(os.fstat(fd)) != identity(info):
            raise RuntimeError('shared lock pid changed while opening')
        data = os.read(fd, 128)
    finally:
        os.close(fd)
    if not data.strip().isdigit() or len(data) == 128:
        raise RuntimeError('invalid shared lock pid')
    pid = int(data)
    if pid <= 1:
        raise RuntimeError('invalid shared lock owner')
    return identity(LOCK_DIR.lstat()), identity(info), data, pid


def require_lock(expected):
    if lock_snapshot() != expected:
        raise RuntimeError('shared lock identity or owner changed')
    ancestor = os.getpid()
    for _ in range(64):
        if ancestor == expected[3]:
            return
        raw = subprocess.check_output(['/bin/ps', '-p', str(ancestor), '-o', 'ppid='], text=True).strip()
        if not raw.isdigit() or int(raw) <= 1:
            break
        ancestor = int(raw)
    raise RuntimeError('shared lock owner must be a live ancestor')


def own_app_pids():
    # Darwin ps comm is the command only (argv[0]), not the full arguments.
    # -ww avoids display truncation. Include every executable within this exact
    # .app, including Frameworks/.../Helpers/..., not merely Contents/MacOS/Arc.
    text = subprocess.check_output(['/bin/ps', '-axww', '-o', 'pid=,comm='], text=True)
    found = []
    for line in text.splitlines():
        fields = line.strip().split(None, 1)
        if len(fields) != 2 or not fields[0].isdigit():
            raise RuntimeError('cannot parse process identity snapshot')
        if fields[1].startswith(APP_PREFIX):
            found.append(int(fields[0]))
    return found


def require_quiet():
    found = own_app_pids()
    if found:
        raise RuntimeError('ours156 app or helper still live; refusing cache mutation: ' + ','.join(map(str, found)))


def entry(parent_fd, name):
    try:
        return os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None


def require_entry(parent_fd, name, expected):
    info = entry(parent_fd, name)
    if info is None or not stat.S_ISDIR(info.st_mode) or identity(info) != expected:
        raise RuntimeError('directory identity drift; preserving cache/backup: ' + name)


def remove_contents(directory_fd, expected, root_guard):
    # Traverse only an opened, validated inode. Never reopen the root by name
    # for recursive deletion: a replaced root must not select a different tree.
    root_guard()
    if identity(os.fstat(directory_fd)) != expected:
        raise RuntimeError('opened cache directory identity drift')
    for name in os.listdir(directory_fd):
        root_guard()
        info = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISDIR(info.st_mode):
            child_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                               dir_fd=directory_fd)
            try:
                child_identity = identity(info)
                if identity(os.fstat(child_fd)) != child_identity:
                    raise RuntimeError('nested cache directory identity drift')
                require_entry(directory_fd, name, child_identity)
                remove_contents(child_fd, child_identity, root_guard)
                root_guard()
                require_entry(directory_fd, name, child_identity)
                os.rmdir(name, dir_fd=directory_fd)
            finally:
                os.close(child_fd)
        else:
            # Unlink the cache entry itself; never follow symlink targets.
            os.unlink(name, dir_fd=directory_fd)


def exclusive_rename(parent_fd, source, destination):
    # SDK sys/stdio.h: exclusive destination and no symlink traversal.
    libc = ctypes.CDLL(None, use_errno=True)
    rename = libc.renameatx_np
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(parent_fd, os.fsencode(source), parent_fd, os.fsencode(destination),
              RENAME_EXCL | RENAME_NOFOLLOW_ANY) != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), str(PARENT / source), str(PARENT / destination))


def exit_status(returncode):
    # subprocess represents signal termination as -signal; expose shell status
    # without sending any signal or taking process-control action ourselves.
    return returncode if returncode >= 0 else 128 - returncode


def main(argv):
    command = argv[1:] if argv[:1] == ['--'] else argv
    if not command:
        raise RuntimeError('usage: isolate-cache-v10.py [--] command [args ...]')
    if sys.platform != 'darwin':
        raise RuntimeError('Darwin-only cache wrapper')
    if not hasattr(os, 'O_NOFOLLOW') or os.open not in os.supports_dir_fd:
        raise RuntimeError('fd-based no-follow filesystem operations required')
    lock = lock_snapshot()
    require_lock(lock)
    require_quiet()
    parent_identity = identity(real_directory(PARENT))
    parent_fd = os.open(PARENT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    backup = NAME + '.sessions-cache-v10-' + uuid.uuid4().hex + '.backup'
    moved = False
    created = False
    isolated_fd = None
    original_identity = None
    isolated_identity = None
    code = None

    def boundary():
        require_lock(lock)
        if identity(real_directory(PARENT)) != parent_identity or identity(os.fstat(parent_fd)) != parent_identity:
            raise RuntimeError('cache parent identity drift')
        require_quiet()

    try:
        boundary()
        if entry(parent_fd, backup) is not None:
            raise RuntimeError('backup collision or symlink')
        original = entry(parent_fd, NAME)
        if original is not None:
            if not stat.S_ISDIR(original.st_mode):
                raise RuntimeError('cache must be a real directory, never a symlink')
            original_identity = identity(original)
            boundary()
            require_entry(parent_fd, NAME, original_identity)
            exclusive_rename(parent_fd, NAME, backup)
            moved = True
            require_entry(parent_fd, backup, original_identity)
        boundary()
        os.mkdir(NAME, mode=0o700, dir_fd=parent_fd)
        created = True
        isolated_fd = os.open(NAME, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
        isolated = os.fstat(isolated_fd)
        if isolated is None or not stat.S_ISDIR(isolated.st_mode):
            raise RuntimeError('isolated cache creation identity unavailable')
        isolated_identity = identity(isolated)
        require_entry(parent_fd, NAME, isolated_identity)
        if os.listdir(isolated_fd):
            raise RuntimeError('new isolated cache unexpectedly populated before child')
        # umask can only remove bits. Require the requested private mode exactly.
        if stat.S_IMODE(isolated.st_mode) != 0o700:
            raise RuntimeError('isolated cache mode must be 0700')
        boundary()
        require_entry(parent_fd, NAME, isolated_identity)
        print('CACHE_ISOLATED', PARENT / NAME, 'backup', PARENT / backup if moved else 'none', flush=True)
        code = exit_status(subprocess.run(command, check=False).returncode)
    except BaseException as exc:
        print('CACHE_COMMAND_ERROR', type(exc).__name__, str(exc), file=sys.stderr, flush=True)
        if isinstance(exc, KeyboardInterrupt):
            code = 130
    finally:
        try:
            if moved or created:
                boundary()
                if moved:
                    require_entry(parent_fd, backup, original_identity)
                if isolated_identity is not None:
                    require_entry(parent_fd, NAME, isolated_identity)
                    def cleanup_root_guard():
                        require_lock(lock)
                        if identity(real_directory(PARENT)) != parent_identity:
                            raise RuntimeError('cache parent identity drift during cleanup')
                        require_entry(parent_fd, NAME, isolated_identity)
                        if moved:
                            require_entry(parent_fd, backup, original_identity)
                    remove_contents(isolated_fd, isolated_identity, cleanup_root_guard)
                    boundary()
                    require_entry(parent_fd, NAME, isolated_identity)
                    os.rmdir(NAME, dir_fd=parent_fd)
                if entry(parent_fd, NAME) is not None:
                    raise RuntimeError('cache destination exists; refusing restoration overwrite')
                boundary()
                if moved:
                    require_entry(parent_fd, backup, original_identity)
                    exclusive_rename(parent_fd, backup, NAME)
                    require_entry(parent_fd, NAME, original_identity)
                elif entry(parent_fd, NAME) is not None:
                    raise RuntimeError('originally absent cache reappeared; refused success marker')
                print('CACHE_RESTORED', PARENT / NAME, 'original' if moved else 'originally absent', flush=True)
        except BaseException as exc:
            print('CACHE_RESTORE_REFUSED', type(exc).__name__, str(exc), file=sys.stderr, flush=True)
            print('CACHE_PRESERVED', PARENT / NAME, 'backup', PARENT / backup if moved else 'none', file=sys.stderr, flush=True)
            # Preserve failed child status. A successful child cannot turn an
            # incomplete restoration transaction into a successful wrapper run.
            if code in (None, 0):
                code = RESTORE_ERROR
        finally:
            if isolated_fd is not None:
                os.close(isolated_fd)
            os.close(parent_fd)
    return code if code is not None else RESTORE_ERROR


if __name__ == '__main__':
    try:
        result = main(sys.argv[1:])
    except BaseException as exc:
        print('CACHE_PREFLIGHT_REFUSED', type(exc).__name__, str(exc), file=sys.stderr, flush=True)
        result = 130 if isinstance(exc, KeyboardInterrupt) else RESTORE_ERROR
    raise SystemExit(result)
