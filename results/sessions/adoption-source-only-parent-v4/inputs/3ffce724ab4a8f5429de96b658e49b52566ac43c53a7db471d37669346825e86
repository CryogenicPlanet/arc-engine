// Ours156-only disposable full-window probe; restart is intentionally unsupported. Run only as a child of arc/tools/locked.sh.
import {existsSync,mkdirSync,readFileSync,writeFileSync,renameSync,readdirSync} from 'node:fs';
import {join,resolve} from 'node:path';
const root='/Users/cryogenicplanet/general/arc-engine';
const {AgentCDP,verifyAgentEndpoint}=await import(join(root,'../arc/tools/agent-cdp.ts'));
const mode=process.env.ARC_SESSIONS_FULL_MODE??'full';
if(mode!=='full')throw Error('ours v5 supports full mode only; restart parser is trace156-specific');
const agent='ours156',port=9464;
const app=resolve(root,'../arc/build/ArcModAgent-ours156.app'),exe=join(app,'Contents/MacOS/Arc');
const dylib='/tmp/arccore-sessions-full-ours-v5.dylib';
const out=resolve(process.env.ARC_SESSIONS_FULL_OUT??join(root,'results/sessions/full-ours-v5-'+mode+'-'+Date.now()));
if(existsSync(out)&&readdirSync(out).length)throw Error('output must be absent or empty to avoid stale probe evidence');
const exec=(args:string[])=>{const r=Bun.spawnSync(args,{stdout:'pipe',stderr:'pipe'});if(!r.success)throw Error('command failed '+args[0]+': '+r.stderr.toString());return r.stdout.toString().trim()};
const sleep=(ms:number)=>new Promise(r=>setTimeout(r,ms));
const json=(p:string)=>JSON.parse(readFileSync(p,'utf8'));
function lockGuard(){
 const lockPID=Number(readFileSync(join(root,'logs/arccore-build.lock/pid'),'utf8').trim());
 if(!Number.isInteger(lockPID)||lockPID<=1)throw Error('invalid lock owner');
 let ancestor=process.pid;
 for(let depth=0;ancestor!==lockPID&&ancestor>1&&depth<32;++depth)ancestor=Number(exec(['/bin/ps','-p',String(ancestor),'-o','ppid=']));
 if(ancestor!==lockPID)throw Error('shared build/run lock ancestry is required');
}
lockGuard();
const pids=()=>exec(['/bin/ps','-axo','pid=,command=']).split('\n').flatMap(r=>{const m=r.match(/^\s*(\d+)\s+(.+)$/);return m&&(m[2]===exe||m[2].startsWith(exe+' '))?[Number(m[1])]:[]});
const plist=(key:string)=>exec(['/usr/libexec/PlistBuddy','-c','Print :'+key,join(app,'Contents/Info.plist')]);
if(plist('ArcModAgentSession')!==agent||plist('CFBundleIdentifier')!=='company.thebrowser.Browser.mod.agent.ours156')throw Error('bundle identity mismatch');
if(!existsSync(dylib))throw Error('compile '+dylib+' first');
if(pids().length)throw Error('ours156 agent already running; refusing attach');
mkdirSync(out,{recursive:true});
const nonce='arc-sessions-full-'+crypto.randomUUID();
const server=Bun.serve({hostname:'127.0.0.1',port:0,fetch(req){
 const u=new URL(req.url);const match=u.pathname.match(new RegExp('^/'+nonce+'/(tab1|tab2)/(A|B|C)$'));
 if(!match)return new Response('missing',{status:404});
 return new Response(`<!doctype html><title>Sessions ${match[1]} ${match[2]}</title><h1>${match[1]} history ${match[2]}</h1>`,{headers:{'content-type':'text/html; charset=utf-8','cache-control':'no-store'}});
}});
const base=`http://127.0.0.1:${server.port}/${nonce}`;
const run:any={agent,mode,nonce,base,phases:[],observations:[],pass:false};
let cdp:any,pid:number|undefined,request='',sequence=0,launchNumber=0,workDeadline=Number.POSITIVE_INFINITY;
const ownedBirth=new Map<number,string>();
const shutdownAttempted=new Set<number>();
const appReadyPath=join(process.env.HOME!,'Library/Application Support','ArcModAgent-ours156','ArcModAgentReady.json');
const profile=join(process.env.HOME!,'Library/Application Support','ArcModAgent-ours156','Agent Chromium Data');
function phase(name:string){run.phase=name;run.phases.push({phase:name,time:new Date().toISOString(),pid});console.log(agent+': '+name);writeFileSync(join(out,'observations.json'),JSON.stringify(run,null,2));}
async function wait<T>(fn:()=>T|Promise<T>,timeout=20000,cleanup=false):Promise<NonNullable<T>>{
 let last:unknown;const deadline=cleanup?Date.now()+timeout:Math.min(workDeadline,Date.now()+timeout);
 while(Date.now()<deadline){try{const v=await fn();if(v)return v as NonNullable<T>}catch(e){last=e}await sleep(80)}
 throw Error('probe wait timeout'+(last?': '+String(last):''));
}
function endpointGuard(){lockGuard();if(!pid||!pids().includes(pid)||verifyAgentEndpoint(agent,port)!==pid)throw Error('PID/endpoint ownership changed');}
async function action(operation:string,values:Record<string,unknown>={}){
 endpointGuard();const id=nonce+'-'+(++sequence);
 writeFileSync(request+'.tmp',JSON.stringify({id,operation,nonce,pid,...values}));renameSync(request+'.tmp',request);
 const response:any=await wait(()=>{const r=json(request+'.response.json');return r.id===id&&r.pid===pid&&r.nonce===nonce?r:null});
 run.observations.push(response);writeFileSync(join(out,'observations.json'),JSON.stringify(run,null,2));
 if(!response.ok)throw Error('probe request failed '+JSON.stringify(response));
 if(response.state.error)throw Error('probe callback failed '+response.state.error);
 return response.state;
}
async function launch(){
 lockGuard();if(pids().length)throw Error('agent already running before launch');
 if(Bun.spawnSync(['/usr/sbin/lsof','-nP',`-iTCP:${port}`,'-sTCP:LISTEN'],{stdout:'ignore',stderr:'ignore'}).success)throw Error('CDP port occupied before launch');
 workDeadline=Date.now()+135000;
 const dir=join(out,'launch-'+(++launchNumber));mkdirSync(dir);request=join(dir,'request.json');
 phase('launch-'+launchNumber);mkdirSync(profile,{recursive:true});
 exec(['/usr/bin/open','-n','-g','-a',app,'--env','DYLD_INSERT_LIBRARIES='+dylib,
  '--env','ARC_SESSIONS_FULL_REQUEST='+request,'--env','ARC_SESSIONS_FULL_NONCE='+nonce,
  '--stdout',join(dir,'app.log'),'--stderr',join(dir,'app.log'),'--args','--use-mock-keychain',
  '--no-default-browser-check','--disable-sync','--disable-background-networking',
  '--host-resolver-rules='+plist('ArcModHostResolverRules'),'--user-data-dir='+profile,
  '--remote-debugging-address=127.0.0.1','--remote-debugging-port='+port]);
 pid=await wait(()=>{const matches=pids();if(matches.length>1)throw Error('multiple exact agent processes');return matches.length===1?matches[0]:undefined});
 run['pid'+launchNumber]=pid;ownedBirth.set(pid,exec(['/bin/ps','-p',String(pid),'-o','lstart=']));
 await wait(()=>{const probe=json(request+'.ready.json'),ready=json(appReadyPath);return probe.pid===pid&&probe.installed&&probe.closeHook&&probe.nonce===nonce&&probe.bundle==='company.thebrowser.Browser.mod.agent.ours156'&&ready.pid===pid&&ready.ready===true},100000);
 await wait(()=>verifyAgentEndpoint(agent,port)===pid,25000);
 cdp=await AgentCDP.connectAgent(agent,port);endpointGuard();phase('ready-'+launchNumber);
}
async function cleanShutdown(){
 lockGuard();const shuttingPID=pid;
 if(!shuttingPID||!pids().includes(shuttingPID))throw Error('owned process absent before shutdown');
 const command=exec(['/bin/ps','-p',String(shuttingPID),'-o','command=']);
 const birth=exec(['/bin/ps','-p',String(shuttingPID),'-o','lstart=']);
 if((command!==exe&&!command.startsWith(exe+' '))||ownedBirth.get(shuttingPID)!==birth)throw Error('owned PID identity changed before shutdown');
 shutdownAttempted.add(shuttingPID);phase('clean-shutdown-'+launchNumber);
 const cleanupID=nonce+'-appkit-cleanup-'+(++sequence);
 writeFileSync(request+'.tmp',JSON.stringify({id:cleanupID,operation:'shutdown',nonce,pid:shuttingPID}));renameSync(request+'.tmp',request);
 run.cleanupMode='real AppKit terminate via owned main queue';
 const appKitEnd=Date.now()+6000;while(pids().includes(shuttingPID)&&Date.now()<appKitEnd)await sleep(100);
 try{const response=json(request+'.response.json');run.appKitCleanupAcknowledged=response.id===cleanupID&&response.pid===shuttingPID&&response.nonce===nonce&&response.ok===true}catch{}
 if(pids().includes(shuttingPID)&&cdp){
  try{await Promise.race([cdp.request('Browser.close',{}),sleep(3000)])}catch(e){run.shutdownTransport=String(e)}
 }
 await wait(()=>!pids().includes(shuttingPID),4000,true);
 if(cdp)await cdp.close();cdp=undefined;pid=undefined;run.ownedAppStillRunning=false;phase('exited-'+launchNumber);
}
async function evaluate(target:string,expression:string){
 endpointGuard();const r=await cdp.targetCommand(target,'Runtime.evaluate',{expression,returnByValue:true,awaitPromise:true});
 if(r.exceptionDetails)throw Error('evaluate exception '+JSON.stringify(r.exceptionDetails));return r.result?.value;
}
async function loaded(target:string,url:string){
 await wait(()=>evaluate(target,`document.readyState==='complete'&&location.href===${JSON.stringify(url)}`));
}
const cleanHistory=(h:any)=>({index:h.currentIndex,pages:h.entries.map((e:any)=>e.url.replace(base,'FIXTURE')),titles:h.entries.map((e:any)=>e.title)});
async function createFixture(tab:string){
 endpointGuard();const target=(await cdp.request('Target.createTarget',{url:base+'/'+tab+'/A',background:true})).targetId;
 if(typeof target!=='string')throw Error('missing fixture target');await loaded(target,base+'/'+tab+'/A');
 for(const page of ['B','C']){endpointGuard();await cdp.targetCommand(target,'Page.navigate',{url:base+'/'+tab+'/'+page});await loaded(target,base+'/'+tab+'/'+page)}
 const h=await cdp.targetCommand(target,'Page.getNavigationHistory',{});const entry=h.entries.find((e:any)=>e.url===base+'/'+tab+'/B');if(!entry)throw Error('B entry missing');
 await cdp.targetCommand(target,'Page.navigateToHistoryEntry',{entryId:entry.id});await loaded(target,base+'/'+tab+'/B');
 const history=cleanHistory(await cdp.targetCommand(target,'Page.getNavigationHistory',{}));
 const expected={index:1,pages:['A','B','C'].map(p=>'FIXTURE/'+tab+'/'+p),titles:['A','B','C'].map(p=>'Sessions '+tab+' '+p)};
 if(JSON.stringify(history)!==JSON.stringify(expected))throw Error('fixture history mismatch '+JSON.stringify(history));
 return {target,history};
}
function assertContract(state:any){
 const wrapperURLs=state.restored.map((r:any)=>r.url).sort(),expectedURLs=[base+'/tab1/B',base+'/tab2/B'].sort();
 if(state.restored.length!==2||state.restored.some((r:any)=>!r.initialized)||JSON.stringify(wrapperURLs)!==JSON.stringify(expectedURLs))throw Error('restored callback wrappers do not match initialized fixture URLs');
 const unexpected=state.events.filter((e:any)=>e.type==='unexpected-create'||e.type==='callback-error');
 if(state.createdCount!==1||state.finishedCount!==1||state.restores!==2||!state.finishedMatchesIdentity||
   !state.createdInitialized||state.oldInitialized||state.createdCanRestore||!state.sentinelCanRestoreAtCreated||
   !state.sentinelInitialized||unexpected.length)throw Error('full-window callback contract failed '+JSON.stringify(state));
 const expectedIDs=state.sourceIDs;
 if(!Array.isArray(expectedIDs)||expectedIDs.length!==2)throw Error('missing strict expected callback IDs');
 const actual=[...state.callbackIDs].sort(),expected=[...expectedIDs].sort();
 if(new Set(actual).size!==2||JSON.stringify(actual)!==JSON.stringify(expected))throw Error('full restore callback IDs differ from '+'source live IDs');
 if(state.events.some((e:any)=>!e.main))throw Error('callback ran off main thread');
 if(state.events.some((e:any)=>(e.type==='restored'||e.type==='finished')&&(e.insideAction!==false||e.insideCloseCallback!==false)))throw Error('nonempty full restore callback was synchronous or reentered close callback');
 const phases=state.events.map((e:any)=>e.type),created=phases.indexOf('created'),finished=phases.indexOf('finished');
 const restores=phases.flatMap((p:string,i:number)=>p==='restored'?[i]:[]);
 if(created<0||finished<0||restores.some((i:number)=>i<=created||i>=finished))throw Error('created/restore/finished ordering failed');
}
try{
 await launch();
 phase('create-two-history-tabs');
 const first=await createFixture('tab1'),second=await createFixture('tab2');run.before={tab1:first.history,tab2:second.history};
 const urls=[base+'/tab1/B',base+'/tab2/B'];
 phase('map-actual-window');await wait(async()=>{try{await action('inspect',{urls});return true}catch(e){run.mappingLastError=String(e);return false}},20000);
 phase('perform-close-actual-window');await action('close-window',{urls});
 const closed:any=await wait(async()=>{const s=await action('status');return s.restorationID&&s.closedCallbackUnwound?s:null},30000);run.closed=closed;
 if(closed.oldInitialized)throw Error('source native browser remains initialized after close callback');
 const persisted={restorationID:closed.restorationID,windowUUID:closed.windowUUID,contextKey:closed.contextKey,sourceIDs:closed.sourceIDs,before:run.before};
 writeFileSync(join(out,'closed-window.json'),JSON.stringify(persisted,null,2));
 phase('restore-full-window');await action('restore-window');
 const after:any=await wait(async()=>{const s=await action('status');return s.finishedCount?s:null},30000);run.after=after;
 assertContract(after);
 phase('verify-restored-history');run.restoredHistory={};
 for(const tab of ['tab1','tab2']){
  const url=base+'/'+tab+'/B';
  const target=await wait(async()=>{endpointGuard();const targets=await cdp.request('Target.getTargets',{});const matches=targets.targetInfos.filter((t:any)=>t.type==='page'&&t.url===url);if(matches.length>1)throw Error('ambiguous restored target');return matches.length===1?matches[0].targetId:null});
  // Restored background tabs may be lazy. Reading history does not navigate or activate them.
  endpointGuard();const history=cleanHistory(await cdp.targetCommand(target,'Page.getNavigationHistory',{}));run.restoredHistory[tab]=history;
  if(JSON.stringify(history)!==JSON.stringify(run.before[tab]))throw Error('restored '+tab+' history changed '+JSON.stringify(history));
 }
 run.contractPass=true;phase('contract-and-history-pass');await cleanShutdown();run.pass=true;phase('complete');
}catch(e){
 run.error=String(e);run.pidAliveAtError=pid?pids().includes(pid):false;
 try{run.appReadyAtError=json(appReadyPath)}catch{}
 phase('error');console.error(agent+': '+run.error);
 // Ask the actual NSApp to terminate first; fallback signals require exact PID, executable and birth time.
 if(pid&&pids().includes(pid)){
  const ownedPID=pid;
  try{
   if(!shutdownAttempted.has(ownedPID)){
    await cleanShutdown();
   }
  }catch(shutdownError){run.cleanupError=String(shutdownError)}
  if(pids().includes(ownedPID)){
   lockGuard();
   const command=exec(['/bin/ps','-p',String(ownedPID),'-o','command=']);
   const birth=exec(['/bin/ps','-p',String(ownedPID),'-o','lstart=']);
   if((command===exe||command.startsWith(exe+' '))&&ownedBirth.get(ownedPID)===birth){
    run.cleanupSignal={pid:ownedPID,signal:'SIGTERM',exactExecutable:exe};
    const terminated=Bun.spawnSync(['/bin/kill','-TERM',String(ownedPID)],{stdout:'pipe',stderr:'pipe'});
    if(!terminated.success)run.cleanupSignalError=terminated.stderr.toString();
    try{await wait(()=>!pids().includes(ownedPID),8000,true)}catch(terminationError){run.cleanupError=String(terminationError)}
   }else run.cleanupError='owned PID identity changed; refused signal';
  }
  run.ownedAppStillRunning=pids().includes(ownedPID);
 }
}finally{
 if(cdp)await cdp.close();server.stop(true);
 writeFileSync(join(out,'observations.json'),JSON.stringify(run,null,2));
 writeFileSync(join(out,'result.json'),JSON.stringify({pass:run.pass,mode,contractPass:run.contractPass??false,error:run.error??null,cleanupError:run.cleanupError??null,closed:run.closed,cleanupMode:run.cleanupMode,appKitCleanupAcknowledged:run.appKitCleanupAcknowledged??false,cleanupSignal:run.cleanupSignal??null,ownedAppStillRunning:run.ownedAppStillRunning??false,after:run.after,before:run.before,restoredHistory:run.restoredHistory},null,2));
 console.log('OUTPUT '+out+' PASS '+run.pass);if(!run.pass)process.exitCode=1;
}
