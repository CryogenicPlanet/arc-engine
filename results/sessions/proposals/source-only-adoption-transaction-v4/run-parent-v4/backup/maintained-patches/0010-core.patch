+class GURL;
+namespace ui { class Compositor; }
+namespace content {
+class WebContents;
+class RenderWidgetHost;
+class BrowserCompositorMac;
+// Synchronous UI-thread callbacks. Arguments are borrowed for the call.
+using HostNavigationStateCallback =
+    base::RepeatingCallback<void(WebContents*, InvalidateTypes)>;
+using HostTargetURLCallback =
+    base::RepeatingCallback<void(WebContents*, const GURL&)>;
+using HostFrameTokenCallback =
+    base::RepeatingCallback<void(WebContents*, RenderWidgetHost*)>;
+using HostSurfaceCopyCallback = HostFrameTokenCallback;
+using HostViewUnparentedCallback = HostFrameTokenCallback;
+using HostOwnCompositorCallback =
+    base::RepeatingCallback<void(BrowserCompositorMac*, ui::Compositor*)>;
+CONTENT_EXPORT HostNavigationStateCallback& GetHostNavigationStateCallback();
+CONTENT_EXPORT HostTargetURLCallback& GetHostTargetURLCallback();
+// Called after a Mac view processes an activated Viz frame token, including
+// frames whose render metadata is unchanged.
+// Frame/copy/unparented consumers must queue app work, never call app/KVO here.
+CONTENT_EXPORT HostFrameTokenCallback& GetHostFrameTokenCallback();
+CONTENT_EXPORT HostSurfaceCopyCallback& GetHostSurfaceCopyCallback();
+CONTENT_EXPORT HostViewUnparentedCallback& GetHostViewUnparentedCallback();
+// Observation changes only; consumers must not call into the app here.
+// Nonnull is sent before own-compositor Unsuspend; null precedes detach and
+// is also sent during destruction after existing weak pointers are invalid.
+CONTENT_EXPORT HostOwnCompositorCallback& GetHostOwnCompositorCallback();
+// Original custom-client phase: synchronous, after ALL WebContentsDestroyed
+// observers and before ResetWebContents/SetDelegate/physical weak invalidation.
+// Only a WC that was outermost before teardown emits this hook. FrameTrees are
+// already shut down. Consumer must find EXISTING ownership; never create a wrapper.
+using HostWebContentsClosedCallback = base::RepeatingCallback<void(WebContents*)>;
+CONTENT_EXPORT HostWebContentsClosedCallback& GetHostWebContentsClosedCallback();
+}  // namespace content
