+SkColor RenderWidgetHostViewMac::BrowserCompositorMacGetGutterColor() const {
+  // When making an element on the page fullscreen the element's background
+  // may not match the page's, so use black as the gutter color to avoid
+  // flashes of brighter colors during the transition.
+  if (host() && host()->delegate() && host()->delegate()->IsFullscreen()) {
+    return SK_ColorBLACK;
+  }
+  return last_frame_root_background_color_;
+}
+
+void RenderWidgetHostViewMac::OnFrameTokenChanged(
+    uint32_t frame_token,
+    base::TimeTicks activation_time) {
+  // Processing the frame token may run activation observers and destroy us.
+  auto weak_this = weak_factory_.GetWeakPtr();
+  OnFrameTokenChangedForView(frame_token, activation_time);
+  if (!weak_this || !weak_this->host()) {
+    return;
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("arcmod-host-app")) {
+    auto callback = GetHostFrameTokenCallback();
+    auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(weak_this->host());
+    if (callback && contents) {
+      callback.Run(contents, weak_this->host());
+    }
+  }
+}
