+std::string WebContentsImpl::GetTitleForMediaControls() {
+  OPTIONAL_TRACE_EVENT0("content", "WebContentsImpl::GetTitleForMediaControls");
+
+  if (!delegate_) {
+    return std::string();
+  }
+  return delegate_->GetTitleForMediaControls(this);
