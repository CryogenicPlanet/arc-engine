+void RenderWidgetHostViewMac::ForwardMouseEvent(
+    const blink::WebMouseEvent& web_event) {
+  if (host())
+    host()->ForwardMouseEvent(web_event);
+
+  if (web_event.GetType() == WebInputEvent::Type::kMouseLeave)
+    SetTooltipText(std::u16string());
+}
