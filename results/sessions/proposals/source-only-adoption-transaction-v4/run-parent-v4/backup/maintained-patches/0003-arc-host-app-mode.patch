+// ArcMod: the setup half of RunContentProcess (process-wide init and
+// |content_main_runner|->Initialize). Returns a non-negative exit code to stop,
+// or -1 to continue with |content_main_runner|->Run(). The caller owns Run() and
+// Shutdown(), so an embedder can initialize the browser and run the loop later.
+// |params.autorelease_pool| is ignored (the embedder owns the run loop's pools).
+CONTENT_EXPORT int InitializeContentProcess(
+    ContentMainParams params,
+    ContentMainRunner* content_main_runner);
