+bool ChromePermissionsClient::CanRequestDevicePermission(
+    ContentSettingsType type) const {
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS)
+  return system_permission_settings::CanPrompt(type);
+#else
