+  zoom_settings.default_zoom_factor =
+      blink::ZoomLevelToZoomFactor(zoom_controller->GetDefaultZoomLevel());
+
+  return RespondNow(
+      ArgumentList(api::tabs::GetZoomSettings::Results::Create(zoom_settings)));
+}
