+}
+
+// static
+void DevToolsWindow::RemoveCreationCallbackForTest(
+    const CreationCallback& callback) {
+  if (auto it = std::ranges::find(GetCreationCallbacks(), callback);
+      it != GetCreationCallbacks().end()) {
+    GetCreationCallbacks().erase(it);
+  }
