+// core: destructor-entry deassociation of an EXISTING facade. UI sequence only.
+// Caller retains the facade and captures app payload while native is usable,
+// prepares BEFORE synchronous global app publication, then runs the returned
+// closure AFTER publication and before native teardown continues. The output
+// pointer must be nonnull and initially empty. False means no matching binding;
+// true can have an empty completion. No wrapper creation or global publication.
+// The completion retains only close state, not native Browser or ObjC facade.
+// This endpoint has no installed native caller; peer-cache audits remain HOLD.
+namespace arc {
+bool PrepareBrowserForNativeDestruction(
+    ArcBrowser* existing, BrowserWindowInterface* expected,
+    base::OnceClosure* after_publication);
+}
