+// Runs synchronously at hosted Browser destruction entry, before the fallback
+// close lifecycle and window/member teardown. Empty by default. Receivers must
+// use only an existing registration and must not retain the native pointer.
+using SessionBrowserPhysicalDestructionHook =
+    base::RepeatingCallback<void(BrowserWindowInterface*)>;
+inline SessionBrowserPhysicalDestructionHook&
+GetSessionBrowserPhysicalDestructionHook() {
+  static base::NoDestructor<SessionBrowserPhysicalDestructionHook> hook;
+  return *hook;
+}
