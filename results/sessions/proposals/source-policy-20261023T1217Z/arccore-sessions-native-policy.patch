+// Hosted configuration chooses the startup type, while profile startup URLs
+// still come from preferences. nullopt leaves Chrome's type lookup unchanged.
+using SessionStartupRestoreHook =
+    base::RepeatingCallback<std::optional<bool>()>;
+inline SessionStartupRestoreHook& GetSessionStartupRestoreHook() {
+  static base::NoDestructor<SessionStartupRestoreHook> hook;
+  return *hook;
+}
 
