--- a/arc/api/arc_sessions_restore.mm
+++ b/arc/api/arc_sessions_restore.mm
@@ -35,6 +35,15 @@
 #include "content/public/browser/navigation_controller.h"
 #include "content/public/browser/web_contents.h"
 
+// Called by lead-owned bootstrap after its single native-order configuration
+// snapshot and before Chrome initializes any profiles. This changes the startup
+// preference producer, not persisted preferences or explicit restore eligibility.
+void ArcSessionsConfigureRestorationPolicy(NSUInteger policy) {
+  CHECK_LE(policy, 1u);
+  arcmod::GetSessionStartupRestoreHook() = base::BindRepeating(
+      [](bool restore) -> std::optional<bool> { return restore; }, policy == 0);
+}
+
 @interface SessionsRestoreIDs : NSObject
 @property(nonatomic) NSUInteger pending;
 @property(nonatomic) BOOL sealed;
