+void BookmarkStorage::CommitPendingWrite(base::OnceClosure done) {
+  // Arc quits without waiting for the startup fence on best-effort tasks to lift.
+  backend_task_runner_->UpdatePriority(base::TaskPriority::USER_BLOCKING);
+  SaveNowIfScheduled();
+  // The save task posts the secondary file's write to the same sequence, so wait one more turn for it.
+  backend_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](scoped_refptr<base::SequencedTaskRunner> runner,
+             base::OnceClosure done) {
+            runner->PostTask(FROM_HERE, std::move(done));
+          },
+          backend_task_runner_,
+          base::BindPostTaskToCurrentDefault(std::move(done))));
+}
