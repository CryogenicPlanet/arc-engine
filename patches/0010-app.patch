+void BookmarkModel::CommitPendingWrite(base::OnceClosure done) {
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      (local_or_syncable_store_ ? 1 : 0) + (account_store_ ? 1 : 0),
+      std::move(done));
+  if (local_or_syncable_store_) {
