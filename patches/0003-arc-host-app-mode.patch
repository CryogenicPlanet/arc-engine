+#if BUILDFLAG(IS_MAC)
+namespace {
+
+// ArcMod: the browser-process delegate for a host app. Initializes the browser
+// (content::BrowserMainRunner) and returns, leaving the main loop to
+// ChromeMainRunHostedBrowser(). Child processes run exactly as in ChromeMain.
+class HostedBrowserMainDelegate : public ChromeMainDelegate {
+ public:
+  using ChromeMainDelegate::ChromeMainDelegate;
+
+  std::variant<int, content::MainFunctionParams> RunProcess(
+      const std::string& process_type,
+      content::MainFunctionParams main_function_params) override {
+    auto result = ChromeMainDelegate::RunProcess(
+        process_type, std::move(main_function_params));
+    if (!process_type.empty() || std::holds_alternative<int>(result)) {
+      return result;
+    }
+    // What content::BrowserMain does, without Run() and Shutdown().
+    base::CurrentProcess::GetInstance().SetProcessType(
+        base::CurrentProcessType::PROCESS_BROWSER);
+    browser_runner_ = content::BrowserMainRunner::Create();
+    int exit_code = browser_runner_->Initialize(
+        std::get<content::MainFunctionParams>(std::move(result)));
+    if (exit_code >= 0) {
+      browser_runner_.reset();
+      return exit_code;
+    }
+    return content::RESULT_CODE_NORMAL_EXIT;
+  }
+
+  std::unique_ptr<content::BrowserMainRunner> browser_runner_;
+};
+
+struct HostedBrowser {
+  std::unique_ptr<HostedBrowserMainDelegate> delegate;
+  std::unique_ptr<content::ContentMainRunner> runner;
+};
+
+HostedBrowser& GetHostedBrowser() {
+  static base::NoDestructor<HostedBrowser> hosted;
+  return *hosted;
+}
+
+}  // namespace
+
+int ChromeMainInitializeHostedBrowser(int argc, const char** argv) {
+  HostedBrowser& hosted = GetHostedBrowser();
+  CHECK(!hosted.runner);
+  hosted.delegate = std::make_unique<HostedBrowserMainDelegate>(
+      StartupTimestamps{.exe_entry_point_ticks = base::TimeTicks::Now()});
+  content::ContentMainParams params(hosted.delegate.get());
+  params.argc = argc;
+  params.argv = argv;
+  base::CommandLine::Init(params.argc, params.argv);
+  GetInitialCommandLineStorage() = *base::CommandLine::ForCurrentProcess();
+  chrome::InitializeExitSixtyNineDetector();
+  SetUpBundleOverrides();
+  base::PoissonAllocationSampler::Init();
+
+  hosted.runner = content::ContentMainRunner::Create();
+  int exit_code =
+      content::InitializeContentProcess(std::move(params), hosted.runner.get());
+  if (exit_code >= 0) {
+    return exit_code ? exit_code : 1;
+  }
+  exit_code = hosted.runner->Run();
+  if (!hosted.delegate->browser_runner_) {
+    return exit_code ? exit_code : 1;  // startup stopped before the main loop
+  }
+  return 0;
+}
+
+int ChromeMainRunHostedBrowser() {
+  HostedBrowser& hosted = GetHostedBrowser();
+  CHECK(hosted.delegate && hosted.delegate->browser_runner_);
+  std::unique_ptr<content::BrowserMainRunner> browser_runner =
+      std::move(hosted.delegate->browser_runner_);
+  int exit_code = browser_runner->Run();
+  browser_runner->Shutdown();
+  hosted.runner->Shutdown();
+  if (IsNormalResultCode(static_cast<ResultCode>(exit_code))) {
+    return content::RESULT_CODE_NORMAL_EXIT;
+  }
+  return exit_code;
+}
+#endif  // BUILDFLAG(IS_MAC)
+
